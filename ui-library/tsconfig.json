{
  "extends": "@nocobase/dev-config/tsconfig/client.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",
    "paths": {
      "@/*": ["./website/*"]
    }
  },
  "include": [
    "registry/**/*.ts",
    "registry/**/*.tsx",
    "website/**/*.ts",
    "website/**/*.tsx",
    "vite.config.ts",
    "vitest.config.ts"
  ]
}
