{
  "name": "@nocobase/ui-library",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:registry": "pnpm registry:build",
    "registry:build": "pnpm exec shadcn build registry.json --output public/r",
    "build": "pnpm registry:build && vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.registry.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "preview": "vite preview"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@nocobase/i18n": "workspace:^",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "date-fns": "^4.4.0",
    "lucide-react": "^0.487.0",
    "react": "catalog:",
    "react-day-picker": "^10.0.1",
    "react-dom": "catalog:",
    "react-i18next": "catalog:",
    "react-router": "catalog:",
    "simple-icons": "^16.30.0"
  },
  "devDependencies": {
    "@nocobase/app-plugin-authentication": "workspace:^",
    "@nocobase/dev-config": "workspace:*",
    "@tailwindcss/vite": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "eslint": "catalog:",
    "shadcn": "^4.18.0",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  },
  "packageManager": "pnpm@11.7.0"
}
