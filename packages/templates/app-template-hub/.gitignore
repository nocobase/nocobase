# Local application configuration
/config.yml
/.env

# Written by `pnpm nocobase collections generate`: a cache of what this machine's database resolves every Collection
# to, down to the dialect's physical types, for every connection. It describes a database rather than the application,
# so it is regenerated rather than committed. Hand-written metadata lives beside it in `database/<connection>/metadata/`
# and is committed.
/database/*/collections/

# Local SQLite database, at the path config.example.yml gives the default connection
/database.sqlite
/database.sqlite-journal
/database.sqlite-wal
/database.sqlite-shm

