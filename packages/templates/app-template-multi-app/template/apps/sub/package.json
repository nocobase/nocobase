    "database/*/seeds/**",
    "public",
    "tests",
    "index.html",
    "components.json",
    "tailwind.config.mjs",
    "vite.config.ts",
    "vitest.config.ts",
    "eslint.config.js",
    "tsconfig.json",
    "tsconfig.node.json",
    "tsconfig.server.json",
