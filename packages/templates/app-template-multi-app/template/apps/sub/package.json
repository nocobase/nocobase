  "imports": {
    "#components/*": "./client/components/*.js",
    "#hooks/*": "./client/hooks/*.js",
    "#lib/*": "./client/lib/*.js",
    "#extensions/*": "./client/extensions/*.js",
    "#pages/*": "./client/pages/*.js",
    "#components/data-table": "./client/components/data-table/index.js"
  },
  "scripts": {
    "dev": "nocobase dev",
    "build": "nocobase build",
    "start": "nocobase start",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
    "fix": "pnpm lint:fix && pnpm format",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --pass-with-no-tests",
    "postinstall": "nocobase skills sync"
  },
  "packageManager": "pnpm@11.11.0",
  "private": true
}
