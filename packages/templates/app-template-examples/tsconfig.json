{
  "extends": "@nocobase/dev-config/tsconfig/client.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",
    "paths": {
      "@/*": ["./client/*"]
    }
  },
  // A workflow package's client form is browser code that the application's
  // Vite build resolves through the workflow plugin's virtual module, so it is
  // typechecked here rather than by the server build.
  "include": ["client", "workflows/*/client"],
  "exclude": ["registry"]
}
