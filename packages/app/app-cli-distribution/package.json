{
  "name": "@nocobase/app-cli-distribution",
  "version": "0.1.0-beta.1",
  "description": "Composable server-side CLI artifact distribution and installation.",
  "license": "Apache-2.0",
  "type": "module",
  "prettier": "@nocobase/dev-config/prettier",
  "engines": {
    "node": ">=24.0.0"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./public-install": {
      "types": "./src/public-install.ts",
      "import": "./src/public-install.ts"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./public-install": {
        "types": "./dist/public-install.d.ts",
        "import": "./dist/public-install.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "fix": "pnpm lint:fix && pnpm format"
  },
  "dependencies": {
    "@nocobase/agent-protocol": "workspace:^",
    "@nocobase/app-cli-client": "workspace:^",
    "hono": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "@nocobase/app-server": "workspace:^"
  },
  "devDependencies": {
    "@nocobase/dev-config": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "vitest": "catalog:"
  }
}
