{
  "name": "@nocobase/agent-runner",
  "version": "0.0.1",
  "description": "The agent runner of NocoBase applications: registers a machine with applications, claims the agent runs they queue, and drives Claude Code, Codex, OpenCode or Pi on them",
  "type": "module",
  "license": "Apache-2.0",
  "prettier": "@nocobase/dev-config/prettier",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "nocobase-runner": "./bin/run.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
    "fix": "pnpm lint:fix && pnpm format"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.285",
    "@nocobase/agent-protocol": "workspace:^",
    "@nocobase/app-cli-client": "workspace:^",
    "@nocobase/cli-envelope": "workspace:^",
    "@oclif/core": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@hono/node-server": "catalog:",
    "@nocobase/dev-config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "hono": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nocobase/nocobase3.git",
    "directory": "packages/app/agent-runner"
  }
}
