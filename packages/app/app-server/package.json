        "types": "./dist/spa/index.d.ts",
        "import": "./dist/spa/index.js"
      },
      "./support": {
        "types": "./dist/support/index.d.ts",
        "import": "./dist/support/index.js"
      },
      "./i18n": {
        "types": "./dist/i18n/index.d.ts",
        "import": "./dist/i18n/index.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "clean": "node ./scripts/clean-dist.mjs",
    "build": "pnpm clean && tsc -p tsconfig.json && node ./scripts/copy-swagger-ui.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tests.json",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
    "fix": "pnpm lint:fix && pnpm format"
  },
  "dependencies": {
    "@hono/node-server": "catalog:",
    "@nocobase/app-websocket": "workspace:^",
    "@nocobase/config": "workspace:^",
    "@nocobase/drive": "workspace:^",
    "@nocobase/snowflake": "workspace:^",
    "@nocobase/logging": "workspace:^",
