{
  "name": "@nocobase/app-cli",
  "version": "1.0.0-beta.8",
  "description": "The NocoBase application command line: runtime commands, plugin management, and the dev and build tooling.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "nocobase": "./bin/run.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "prettier": "@nocobase/dev-config/prettier",
  "oclif": {
    "bin": "nocobase",
    "topicSeparator": " "
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./testing": {
      "types": "./src/testing.ts",
      "import": "./src/testing.ts",
      "default": "./src/testing.ts"
    },
    "./runtime": {
      "types": "./src/runtime/index.ts",
      "import": "./src/runtime/index.ts",
      "default": "./src/runtime/index.ts"
    },
    "./dev/proxy": {
      "types": "./src/tools/scripts/dev/proxy.d.mts",
      "import": "./src/tools/scripts/dev/proxy.mjs",
      "default": "./src/tools/scripts/dev/proxy.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./testing": {
        "types": "./dist/testing.d.ts",
        "import": "./dist/testing.js",
        "default": "./dist/testing.js"
      },
      "./runtime": {
        "types": "./dist/runtime/index.d.ts",
        "import": "./dist/runtime/index.js",
        "default": "./dist/runtime/index.js"
      },
      "./dev/proxy": {
        "types": "./dist/tools/scripts/dev/proxy.d.mts",
        "import": "./dist/tools/scripts/dev/proxy.mjs",
        "default": "./dist/tools/scripts/dev/proxy.mjs"
      },
      "./package.json": "./package.json"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nocobase/nocobase3.git",
    "directory": "packages/app/app-cli"
  },
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest run",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
    "fix": "pnpm lint:fix && pnpm format",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@clack/prompts": "catalog:",
    "@nocobase/cli-envelope": "workspace:^",
    "@nocobase/logging": "workspace:^",
    "@oclif/core": "catalog:",
    "cross-spawn": "catalog:",
    "execa": "^10.0.1",
    "yaml": "catalog:"
  },
  "peerDependencies": {
    "@nocobase/app-server": "workspace:^",
    "@nocobase/db": "workspace:^",
    "@nocobase/dev-config": "workspace:^",
    "@refinedev/cli": "^2.16.48",
    "prettier": "catalog:",
    "tar": "catalog:",
    "tsc-alias": "^1.9.2",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  },
  "peerDependenciesMeta": {
    "@nocobase/dev-config": {
      "optional": true
    },
    "@refinedev/cli": {
      "optional": true
    },
    "prettier": {
      "optional": true
    },
    "tar": {
      "optional": true
    },
    "tsc-alias": {
      "optional": true
    },
    "tsx": {
      "optional": true
    },
    "typescript": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nocobase/db-sqlite": "workspace:^",
    "@nocobase/dev-config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "publint": "catalog:",
    "tar": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
