{
  "name": "@nocobase/app-client",
  "version": "1.0.0-beta.22",
  "description": "React and Refine runtime for NocoBase applications.",
  "type": "module",
  "prettier": "@nocobase/dev-config/prettier",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./plugins": {
      "types": "./src/plugins.ts",
      "import": "./src/plugins.ts"
    },
    "./runtime": {
      "types": "./src/runtime/index.ts",
      "import": "./src/runtime/index.ts"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./plugins": {
        "types": "./dist/plugins.d.ts",
        "import": "./dist/plugins.js"
      },
      "./runtime": {
        "types": "./dist/runtime/index.d.ts",
        "import": "./dist/runtime/index.js"
      }
    },
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "node ./scripts/clean-dist.mjs",
    "build": "pnpm clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
    "fix": "pnpm lint:fix && pnpm format"
  },
  "peerDependencies": {
    "@nocobase/i18n": "workspace:^",
    "@refinedev/core": "^5.0.0",
    "@refinedev/react-router": "^2.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^17.0.0",
    "react-router": "^7.0.0",
    "@nocobase/service-provider": "workspace:^"
  },
  "dependencies": {
    "@nocobase/api-client": "workspace:^",
    "@nocobase/realtime": "workspace:^"
  },
  "devDependencies": {
    "@nocobase/dev-config": "workspace:*",
    "@nocobase/i18n": "workspace:*",
    "@nocobase/service-provider": "workspace:*",
    "@refinedev/core": "catalog:",
    "@refinedev/react-router": "^2.0.0",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "eslint": "catalog:",
    "jsdom": "catalog:",
    "prettier": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-i18next": "catalog:",
    "react-router": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
