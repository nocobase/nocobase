{
  "name": "@nocobase/app-testing",
  "version": "0.1.0-beta.1",
  "description": "Test fixtures for NocoBase applications and plugins: an application on isolated test databases, its commands, and its pages rendered in a client application, on whichever dialect the environment selects.",
  "type": "module",
  "prettier": "@nocobase/dev-config/prettier",
  "engines": {
    "node": ">=24.0.0"
  },
  "exports": {
    "./server": {
      "types": "./src/server/index.ts",
      "import": "./src/server/index.ts"
    },
    "./cli": {
      "types": "./src/cli/index.ts",
      "import": "./src/cli/index.ts"
    },
    "./client": {
      "types": "./src/client/index.ts",
      "import": "./src/client/index.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      "./server": {
        "types": "./dist/src/server/index.d.ts",
        "import": "./dist/src/server/index.js"
      },
      "./cli": {
        "types": "./dist/src/cli/index.d.ts",
        "import": "./dist/src/cli/index.js"
      },
      "./client": {
        "types": "./dist/src/client/index.d.ts",
        "import": "./dist/src/client/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest run",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
    "fix": "pnpm lint:fix && pnpm format"
  },
  "dependencies": {
    "@nocobase/db-testing": "workspace:^"
  },
  "peerDependencies": {
    "@nocobase/app-cli": "workspace:^",
    "@nocobase/app-client": "workspace:^",
    "@nocobase/app-server": "workspace:^",
    "@nocobase/db": "workspace:^",
    "@nocobase/db-dameng": "workspace:^",
    "@nocobase/db-kingbase": "workspace:^",
    "@nocobase/db-mssql": "workspace:^",
    "@nocobase/db-mysql": "workspace:^",
    "@nocobase/db-oceanbase": "workspace:^",
    "@nocobase/db-oracle": "workspace:^",
    "@nocobase/db-postgres": "workspace:^",
    "@nocobase/db-sqlite": "workspace:^",
    "@nocobase/i18n": "workspace:^",
    "@nocobase/service-provider": "workspace:^",
    "@oclif/core": "catalog:",
    "@testing-library/react": "catalog:",
    "react": "catalog:",
    "react-router": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependenciesMeta": {
    "@nocobase/app-cli": {
      "optional": true
    },
    "@nocobase/app-client": {
      "optional": true
    },
    "@nocobase/app-server": {
      "optional": true
    },
    "@nocobase/db-dameng": {
      "optional": true
    },
    "@nocobase/db-kingbase": {
      "optional": true
    },
    "@nocobase/db-mssql": {
      "optional": true
    },
    "@nocobase/db-mysql": {
      "optional": true
    },
    "@nocobase/db-oceanbase": {
      "optional": true
    },
    "@nocobase/db-oracle": {
      "optional": true
    },
    "@nocobase/db-postgres": {
      "optional": true
    },
    "@nocobase/i18n": {
      "optional": true
    },
    "@nocobase/service-provider": {
      "optional": true
    },
    "@oclif/core": {
      "optional": true
    },
    "@testing-library/react": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-router": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nocobase/app-cli": "workspace:*",
    "@nocobase/app-client": "workspace:*",
    "@nocobase/app-server": "workspace:*",
    "@nocobase/db": "workspace:*",
    "@nocobase/db-sqlite": "workspace:*",
    "@nocobase/dev-config": "workspace:*",
    "@nocobase/i18n": "workspace:*",
    "@nocobase/service-provider": "workspace:*",
    "@oclif/core": "catalog:",
    "@refinedev/core": "catalog:",
    "@refinedev/react-router": "^2.0.0",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "eslint": "catalog:",
    "hono": "catalog:",
    "jsdom": "catalog:",
    "prettier": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-i18next": "catalog:",
    "react-router": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
