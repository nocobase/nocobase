{
  "name": "@nocobase/create-module",
  "version": "0.0.1",
  "type": "module",
  "description": "Create a business module in a NocoBase application.",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "create-module": "./bin/run.mjs"
  },
  "files": [
    "bin",
    "src",
    "template",
    "README.md",
    "CHANGELOG.md"
  ],
  "prettier": "@nocobase/dev-config/prettier",
  "dependencies": {
    "@nocobase/create-plugin": "workspace:^",
    "prettier": "catalog:",
    "@nocobase/dev-config": "workspace:^"
  },
  "scripts": {
    "test": "pnpm --filter @nocobase/create-plugin --filter @nocobase/app-cli build && node --test tests/*.test.mjs && vitest run",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "pnpm lint && pnpm format:check && pnpm test",
    "build": "node --check bin/run.mjs && node --check src/create.mjs && node --check src/templates.mjs"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nocobase/nocobase.git",
    "directory": "packages/tools/create-module"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@nocobase/app-plugin-modules": "workspace:*",
    "@nocobase/app-cli": "workspace:*",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "@types/node": "catalog:",
    "vitest": "catalog:",
    "@nocobase/app-testing": "workspace:*",
    "@nocobase/app-server": "workspace:*",
    "@nocobase/app-plugin-authentication": "workspace:*",
    "@nocobase/app-template-default": "workspace:*"
  }
}
