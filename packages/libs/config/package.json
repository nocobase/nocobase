{
  "name": "@nocobase/config",
  "version": "0.1.0-beta.2",
  "description": "Composable configuration providers and parsers for NocoBase.",
  "type": "module",
  "prettier": "@nocobase/dev-config/prettier",
  "engines": {
    "node": ">=24.0.0"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./providers/*": {
      "types": "./src/providers/*.ts",
      "import": "./src/providers/*.ts"
    },
    "./parsers/*": {
      "types": "./src/parsers/*.ts",
      "import": "./src/parsers/*.ts"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./providers/*": {
        "types": "./dist/providers/*.d.ts",
        "import": "./dist/providers/*.js"
      },
      "./parsers/*": {
        "types": "./dist/parsers/*.d.ts",
        "import": "./dist/parsers/*.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "pnpm clean && tsc -p tsconfig.json",
    "clean": "node ./scripts/clean-dist.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
    "fix": "pnpm lint:fix && pnpm format"
  },
  "dependencies": {
    "yaml": "catalog:",
    "@iarna/toml": "^2.2.5"
  },
  "devDependencies": {
    "@nocobase/dev-config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
