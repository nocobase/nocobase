{
  "name": "@nocobase/backup",
  "version": "0.0.1",
  "description": "Application database and local file backups and restores for NocoBase.",
  "type": "module",
  "prettier": "@nocobase/dev-config/prettier",
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./errors": {
      "types": "./src/errors/index.ts",
      "import": "./src/errors/index.ts"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./errors": {
        "types": "./dist/errors/index.d.ts",
        "import": "./dist/errors/index.js"
      }
    },
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "skills"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
    "fix": "pnpm lint:fix && pnpm format"
  },
  "devDependencies": {
    "@nocobase/dev-config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@types/better-sqlite3": "^7.6.13",
    "@types/pg": "^8.20.0"
  },
  "dependencies": {
    "better-sqlite3": "catalog:",
    "mysql2": "^3.23.3",
    "pg": "^8.23.0",
    "tar": "catalog:",
    "zod": "catalog:"
  }
}
