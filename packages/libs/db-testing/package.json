{
  "name": "@nocobase/db-testing",
  "version": "0.0.1",
  "description": "Portable database test fixtures for @nocobase/db: tests run on SQLite by default and on any dialect selected by environment variable.",
  "type": "module",
  "prettier": "@nocobase/dev-config/prettier",
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./vitest": {
      "types": "./src/vitest.ts",
      "import": "./src/vitest.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/src/index.d.ts",
        "import": "./dist/src/index.js"
      },
      "./vitest": {
        "types": "./dist/src/vitest.d.ts",
        "import": "./dist/src/vitest.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest run",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
    "fix": "pnpm lint:fix && pnpm format"
  },
  "peerDependencies": {
    "@nocobase/db": "workspace:^",
    "@nocobase/db-dameng": "workspace:^",
    "@nocobase/db-kingbase": "workspace:^",
    "@nocobase/db-mssql": "workspace:^",
    "@nocobase/db-mysql": "workspace:^",
    "@nocobase/db-oceanbase": "workspace:^",
    "@nocobase/db-oracle": "workspace:^",
    "@nocobase/db-postgres": "workspace:^",
    "@nocobase/db-sqlite": "workspace:^",
    "vitest": "catalog:"
  },
  "peerDependenciesMeta": {
    "@nocobase/db-dameng": {
      "optional": true
    },
    "@nocobase/db-kingbase": {
      "optional": true
    },
    "@nocobase/db-mssql": {
      "optional": true
    },
    "@nocobase/db-mysql": {
      "optional": true
    },
    "@nocobase/db-oceanbase": {
      "optional": true
    },
    "@nocobase/db-oracle": {
      "optional": true
    },
    "@nocobase/db-postgres": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nocobase/db": "workspace:*",
    "@nocobase/db-dameng": "workspace:*",
    "@nocobase/db-kingbase": "workspace:*",
    "@nocobase/db-mssql": "workspace:*",
    "@nocobase/db-mysql": "workspace:*",
    "@nocobase/db-oceanbase": "workspace:*",
    "@nocobase/db-oracle": "workspace:*",
    "@nocobase/db-postgres": "workspace:*",
    "@nocobase/db-sqlite": "workspace:*",
    "@nocobase/dev-config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
