{
  "name": "@nocobase/authorization",
  "version": "1.0.0-beta.11",
  "type": "module",
  "prettier": "@nocobase/dev-config/prettier",
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./core": {
      "types": "./src/core/index.ts",
      "import": "./src/core/index.ts"
    },
    "./permission-sets": {
      "types": "./src/plugins/permission-sets/index.ts",
      "import": "./src/plugins/permission-sets/index.ts"
    },
    "./default-access": {
      "types": "./src/plugins/default-access/index.ts",
      "import": "./src/plugins/default-access/index.ts"
    },
    "./sharing-rules": {
      "types": "./src/plugins/sharing-rules/index.ts",
      "import": "./src/plugins/sharing-rules/index.ts"
    },
    "./restriction-rules": {
      "types": "./src/plugins/restriction-rules/index.ts",
      "import": "./src/plugins/restriction-rules/index.ts"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./core": {
        "types": "./dist/core/index.d.ts",
        "import": "./dist/core/index.js"
      },
      "./permission-sets": {
        "types": "./dist/plugins/permission-sets/index.d.ts",
        "import": "./dist/plugins/permission-sets/index.js"
      },
      "./default-access": {
        "types": "./dist/plugins/default-access/index.d.ts",
        "import": "./dist/plugins/default-access/index.js"
      },
      "./sharing-rules": {
        "types": "./dist/plugins/sharing-rules/index.d.ts",
        "import": "./dist/plugins/sharing-rules/index.js"
      },
      "./restriction-rules": {
        "types": "./dist/plugins/restriction-rules/index.d.ts",
        "import": "./dist/plugins/restriction-rules/index.js"
      }
    },
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
    "fix": "pnpm lint:fix && pnpm format"
  },
  "dependencies": {
    "hono": "catalog:"
  },
  "devDependencies": {
    "@nocobase/dev-config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@nocobase/db": "workspace:^"
  }
}
