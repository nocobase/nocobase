{
  "name": "@nocobase/db-testkit",
  "version": "0.1.0-beta.2",
  "description": "Shared test contracts for @nocobase/db dialects.",
  "type": "module",
  "prettier": "@nocobase/dev-config/prettier",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./integration-runner": {
      "types": "./src/integration-runner.ts",
      "import": "./src/integration-runner.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/src/index.d.ts",
        "import": "./dist/src/index.js"
      },
      "./integration-runner": {
        "types": "./dist/src/integration-runner.d.ts",
        "import": "./dist/src/integration-runner.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run tests/index.test.ts tests/unit",
    "check": "pnpm lint && pnpm typecheck && pnpm typecheck:unit && pnpm typecheck:integration && pnpm test && pnpm build",
    "typecheck:integration": "tsc -p tsconfig.integration.json --noEmit",
    "typecheck:unit": "tsc -p tsconfig.unit.json --noEmit"
  },
  "peerDependencies": {
    "@nocobase/db": "workspace:^"
  },
  "devDependencies": {
    "@nocobase/db": "workspace:*",
    "@nocobase/dev-config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "knex": "catalog:",
    "typescript": "catalog:"
  },
  "dependencies": {
    "vitest": "catalog:"
  }
}
