{
  "name": "@nocobase/app-plugin-skills-example",
  "displayName": "Skills Example App Plugin",
  "description": "A small App Notice component and authenticated Server API for demonstrating Plugin Skills.",
  "version": "1.0.0-beta.6",
  "type": "module",
  "prettier": "@nocobase/dev-config/prettier",
  "engines": {
    "node": ">=24.0.0"
  },
  "sideEffects": false,
  "exports": {
    "./server": {
      "types": "./server/index.ts",
      "import": "./server/index.ts"
    },
    "./server/tokens": {
      "types": "./server/tokens.ts",
      "import": "./server/tokens.ts"
    },
    "./client/components/app-notice": {
      "types": "./client/components/app-notice.tsx",
      "import": "./client/components/app-notice.tsx"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "skills"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      "./server": {
        "types": "./dist/server/index.d.ts",
        "import": "./dist/server/index.js"
      },
      "./server/tokens": {
        "types": "./dist/server/tokens.d.ts",
        "import": "./dist/server/tokens.js"
      },
      "./client/components/app-notice": {
        "types": "./dist/client/components/app-notice.d.ts",
        "import": "./dist/client/components/app-notice.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
    "fix": "pnpm lint:fix && pnpm format"
  },
  "dependencies": {
    "hono": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "@nocobase/app-plugin-authentication": "workspace:^",
    "@nocobase/app-server": "workspace:^",
    "@nocobase/service-provider": "workspace:^",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@nocobase/dev-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
