{
  "name": "@nocobase/runjs-workspace",
  "version": "2.2.0-beta.15",
  "main": "lib/index.js",
  "types": "./lib/index.d.ts",
  "typesVersions": {
    "*": {
      "server": [
        "./lib/server/index.d.ts"
      ],
      "shared": [
        "./lib/shared/index.d.ts"
      ]
    }
  },
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "require": "./lib/index.js"
    },
    "./server": {
      "types": "./lib/server/index.d.ts",
      "import": "./lib/server/index.js",
      "require": "./lib/server/index.js"
    },
    "./shared": {
      "types": "./lib/shared/index.d.ts",
      "import": "./lib/shared/index.js",
      "require": "./lib/shared/index.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@nocobase/light-extension-sdk": "2.2.0-beta.15",
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "typescript": "5.1.3"
  },
  "peerDependencies": {
    "@nocobase/actions": "2.x",
    "@nocobase/database": "2.x",
    "@nocobase/resourcer": "2.x",
    "@nocobase/runjs": "2.2.0-beta.15",
    "@nocobase/server": "2.x"
  }
}
