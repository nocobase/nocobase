    "@nocobase/app-plugin-notification-providers": "workspace:^",
    "@nocobase/app-plugin-projects": "workspace:^",
    "@nocobase/app-plugin-releases": "workspace:^",
    "@nocobase/app-plugin-scheduler": "workspace:^",
    "@nocobase/app-plugin-users": "workspace:^",
    "@nocobase/app-server": "workspace:^",
    "@nocobase/authorization": "workspace:^",
    "@nocobase/caching": "workspace:^",
    "@nocobase/config": "workspace:^",
    "@nocobase/db": "workspace:^",
    "@nocobase/db-postgres": "workspace:^",
    "@nocobase/db-sqlite": "workspace:^",
    "@nocobase/i18n": "workspace:^",
    "@nocobase/jobs": "workspace:^",
    "@nocobase/markdown-mermaid": "workspace:^",
    "@nocobase/queue": "workspace:^",
    "@nocobase/repository-input": "workspace:^",
    "@nocobase/service-provider": "workspace:^",
    "@nocobase/snowflake": "workspace:^",
    "@oclif/core": "catalog:",
    "@octokit/auth-app": "^8.3.1",
    "@octokit/core": "^7.0.8",
    "@octokit/graphql": "^9.0.5",
    "@octokit/oauth-methods": "^6.0.5",
    "@octokit/request-error": "^7.1.2",
    "@octokit/webhooks-methods": "^6.0.0",
    "better-auth": "catalog:",
    "hono": "catalog:",
    "yaml": "catalog:",
    "zod": "catalog:"
  },
  "scripts": {
    "postinstall": "nocobase skills sync",
    "dev": "nocobase dev",
    "build": "nocobase build",
    "start": "nocobase start",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
    "fix": "pnpm lint:fix && pnpm format",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --project=e2e",
    "test:screenshots": "playwright test --project=screenshots",
    "openapi:check": "node ./scripts/check-openapi.mjs",
    "cli-reference": "node ./scripts/gen-cli-reference.mjs",
    "cli-reference:check": "node ./scripts/gen-cli-reference.mjs --check"
  },
  "packageManager": "pnpm@11.7.0"
}
