{
  "name": "@nocobase/studio",
  "displayName": "NocoBase Studio",
  "version": "1.0.0-beta.51",
  "description": "NocoBase Studio: an AI application workspace of projects and issues worked on by agents, knowledge, builds, releases and deployments.",
  "type": "module",
  "prettier": "@nocobase/dev-config/prettier",
  "engines": {
    "node": ">=24.0.0"
  },
  "nocobase": {
    "templateKind": "app",
    "defaultTemplateVersion": "1.0.0-beta.51",
    "templatePackage": "@nocobase/app-template-default",
    "cli": {
      "bin": "nb-studio",
      "displayName": "NocoBase Studio",
      "description": "The nb-studio command line: signs in to a Studio server and runs the business commands it publishes, for people and for agents in a run.",
      "stateDir": ".nb-studio",
      "homeEnv": "NB_STUDIO_HOME",
      "envPrefix": "NB_STUDIO",
      "keychainEnv": "NB_STUDIO_KEYCHAIN",
      "runCredentialsFile": ".nb-studio/run.json",
      "exampleServer": "https://studio.example.com",
      "auth": {
        "clientId": "nb-studio"
      },
      "skills": [
        "ai/skills/nb-studio-cli"
      ]
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nocobase/nocobase.git",
    "directory": "packages/apps/studio"
  },
  "devDependencies": {
    "@base-ui/react": "catalog:",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/state": "^6.7.2",
    "@codemirror/view": "^6.43.10",
    "@dnd-kit/core": "catalog:",
    "@dnd-kit/sortable": "catalog:",
    "@dnd-kit/utilities": "catalog:",
    "@gchust/agent-annotations": "0.1.9",
    "@hookform/resolvers": "^5.0.1",
    "@nocobase/agent-runner": "workspace:^",
    "@nocobase/app-cli-client": "workspace:^",
    "@nocobase/app-client": "workspace:^",
    "@nocobase/app-plugin-template-print": "workspace:*",
    "@nocobase/app-skills": "workspace:*",
    "@nocobase/app-testing": "workspace:*",
    "@nocobase/app-websocket": "workspace:^",
    "@nocobase/dev-config": "workspace:*",
    "@nocobase/drive": "workspace:^",
    "@nocobase/logging": "workspace:^",
    "@nocobase/session": "workspace:^",
    "@nocobase/studio-cli": "workspace:^",
    "@playwright/test": "catalog:",
    "@refinedev/cli": "^2.16.48",
    "@refinedev/core": "catalog:",
    "@refinedev/react-hook-form": "^5.0.0",
    "@refinedev/react-router": "^2.0.0",
    "@refinedev/react-table": "^6.0.0",
    "@shadcn/react": "^0.3.1",
    "@silurus/ooxml": "0.85.1",
    "@tailwindcss/postcss": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-table": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@tiptap/core": "catalog:",
    "@tiptap/extension-link": "catalog:",
    "@tiptap/extension-file-handler": "catalog:",
    "@tiptap/extension-list": "catalog:",
    "@tiptap/extension-mention": "catalog:",
    "@tiptap/extension-placeholder": "catalog:",
    "@tiptap/extension-table": "catalog:",
    "@tiptap/extension-text-style": "catalog:",
    "@tiptap/markdown": "catalog:",
    "@tiptap/pm": "catalog:",
    "@tiptap/react": "catalog:",
    "@tiptap/starter-kit": "catalog:",
    "@tiptap/suggestion": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "class-variance-authority": "catalog:",
    "cn": "catalog:",
    "cmdk": "^1.1.1",
    "codemirror": "^6.0.2",
    "date-fns": "^4.1.0",
    "dayjs": "^1.10.7",
    "dingtalk-jsapi": "3.1.1",
    "embla-carousel-react": "^8.6.0",
    "eslint": "catalog:",
    "ignore": "catalog:",
    "input-otp": "^1.4.2",
    "jsdom": "catalog:",
    "knex": "catalog:",
    "lucide-react": "catalog:",
    "next-themes": "^0.4.6",
    "postcss": "catalog:",
    "prettier": "catalog:",
    "react": "catalog:",
    "react-day-picker": "10.0.1",
    "react-dom": "catalog:",
    "react-error-boundary": "^6.0.0",
    "react-hook-form": "^7.57.0",
    "react-i18next": "catalog:",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.12.2",
    "react-router": "catalog:",
    "react-virtuoso": "catalog:",
    "recharts": "^3.8.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "catalog:",
    "tailwindcss": "catalog:",
    "tar": "catalog:",
    "tsc-alias": "^1.9.2",
    "tsx": "catalog:",
    "tw-animate-css": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "files": [
    ".prettierignore",
    "cli",
    "client",
    "server",
    "database/tsconfig.json",
    "database/*/migrations/**",
    "database/*/seeds/**",
    "public",
    "index.html",
    "components.json",
    "tailwind.config.mjs",
    "vite.config.ts",
    "vitest.config.ts",
    "eslint.config.js",
    "tsconfig.json",
    "tsconfig.node.json",
    "tsconfig.server.json",
    "ecosystem.config.js",
    "Dockerfile",
    "Dockerfile.dockerignore",
    "config.example.yml",
    "README.MD",
    "AGENTS.md",
    "CLAUDE.md",
    "playwright.config.ts"
  ],
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "dependencies": {
    "@noble/ciphers": "^2.3.0",
    "@noble/hashes": "^2.3.0",
    "@nocobase/agent-protocol": "workspace:^",
    "@nocobase/app-cli": "workspace:^",
    "@nocobase/app-host-docker": "workspace:^",
    "@nocobase/app-plugin-agents": "workspace:^",
    "@nocobase/app-plugin-api-keys": "workspace:^",
    "@nocobase/app-plugin-authentication": "workspace:^",
