{
  "name": "@nocobase/app-plugin-knowledge",
  "displayName": "Knowledge base",
  "description": "Spaces of versioned Markdown documents with search, proposals and review, and snapshot export.",
  "version": "0.1.0-beta.12",
  "type": "module",
  "prettier": "@nocobase/dev-config/prettier",
  "engines": {
    "node": ">=24.0.0"
  },
  "sideEffects": false,
  "exports": {
    "./server": {
      "types": "./server/index.ts",
      "import": "./server/index.ts"
    },
    "./server/tokens": {
      "types": "./server/tokens.ts",
      "import": "./server/tokens.ts"
    },
    "./config": {
      "types": "./config.ts",
      "import": "./config.ts"
    },
    "./server/indexing": {
      "types": "./server/indexing/index.ts",
      "import": "./server/indexing/index.ts"
    },
    "./shared/indexing": {
      "types": "./shared/indexing.ts",
      "import": "./shared/indexing.ts"
    },
    "./shared/access": {
      "types": "./shared/access.ts",
      "import": "./shared/access.ts"
    },
    "./shared/knowledge": {
      "types": "./shared/knowledge.ts",
      "import": "./shared/knowledge.ts"
    },
    "./client": {
      "types": "./client/index.ts",
      "import": "./client/index.ts"
    },
    "./client/indexing": {
      "types": "./client/indexing/index.ts",
      "import": "./client/indexing/index.ts"
    },
    "./client/plugin": {
      "types": "./client/plugin.ts",
      "import": "./client/plugin.ts"
    },
    "./client/routes": {
      "types": "./client/routes.ts",
      "import": "./client/routes.ts"
    },
    "./client/pages": {
      "types": "./client/pages.ts",
      "import": "./client/pages.ts"
    },
    "./client/api": {
      "types": "./client/api.ts",
      "import": "./client/api.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs",
    "database/README.md",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      "./server": {
        "types": "./dist/server/index.d.ts",
        "import": "./dist/server/index.js"
      },
      "./server/tokens": {
        "types": "./dist/server/tokens.d.ts",
        "import": "./dist/server/tokens.js"
      },
      "./config": {
        "types": "./dist/config.d.ts",
        "import": "./dist/config.js"
      },
      "./server/indexing": {
        "types": "./dist/server/indexing/index.d.ts",
        "import": "./dist/server/indexing/index.js"
      },
      "./shared/indexing": {
        "types": "./dist/shared/indexing.d.ts",
        "import": "./dist/shared/indexing.js"
      },
      "./shared/access": {
        "types": "./dist/shared/access.d.ts",
        "import": "./dist/shared/access.js"
      },
      "./shared/knowledge": {
        "types": "./dist/shared/knowledge.d.ts",
        "import": "./dist/shared/knowledge.js"
      },
      "./client": {
        "types": "./dist/client/index.d.ts",
        "import": "./dist/client/index.js"
      },
      "./client/indexing": {
        "types": "./dist/client/indexing/index.d.ts",
        "import": "./dist/client/indexing/index.js"
      },
      "./client/plugin": {
        "types": "./dist/client/plugin.d.ts",
        "import": "./dist/client/plugin.js"
      },
      "./client/routes": {
        "types": "./dist/client/routes.d.ts",
        "import": "./dist/client/routes.js"
      },
      "./client/pages": {
        "types": "./dist/client/pages.d.ts",
        "import": "./dist/client/pages.js"
      },
      "./client/api": {
        "types": "./dist/client/api.d.ts",
        "import": "./dist/client/api.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && nocobase-db-manifests",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
    "fix": "pnpm lint:fix && pnpm format"
  },
  "dependencies": {
    "better-sqlite3": "catalog:",
    "pg": "^8.23.0",
    "sqlite-vec": "^0.1.9",
    "hono": "catalog:",
    "@nocobase/document-extractor": "workspace:^",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "@base-ui/react": "catalog:",
    "@nocobase/app-client": "workspace:^",
    "@nocobase/app-plugin-agents": "workspace:^",
    "@nocobase/app-plugin-authentication": "workspace:^",
    "@nocobase/app-plugin-authorization": "workspace:^",
    "@nocobase/app-plugin-file": "workspace:^",
    "@nocobase/app-server": "workspace:^",
    "@nocobase/authorization": "workspace:^",
    "@nocobase/db": "workspace:^",
    "@nocobase/i18n": "workspace:^",
    "@nocobase/jobs": "workspace:^",
    "@nocobase/markdown-mermaid": "workspace:^",
    "@nocobase/service-provider": "workspace:^",
    "@silurus/ooxml": "0.85.1",
    "@tanstack/react-query": "catalog:",
    "class-variance-authority": "catalog:",
    "cmdk": "catalog:",
    "cn": "catalog:",
    "lucide-react": "catalog:",
    "react": "^19.0.0",
    "react-markdown": "catalog:",
    "react-resizable-panels": "^4.12.2",
    "react-router": "catalog:",
    "remark-gfm": "catalog:"
  },
  "peerDependenciesMeta": {
    "@nocobase/app-plugin-agents": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nocobase/app-testing": "workspace:*",
    "@nocobase/db-sqlite": "workspace:*",
    "@nocobase/dev-config": "workspace:*",
    "@nocobase/drive": "workspace:*",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/better-sqlite3": "^7.6.13",
    "@types/pg": "^8.15.5",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "eslint": "catalog:",
    "jsdom": "catalog:",
    "prettier": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
