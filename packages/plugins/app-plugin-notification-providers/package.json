{
  "name": "@nocobase/app-plugin-notification-providers",
  "displayName": "Notification Providers App Plugin",
  "description": "Provides built-in notification Channels and Providers.",
  "version": "0.2.0-beta.8",
  "type": "module",
  "prettier": "@nocobase/dev-config/prettier",
  "engines": {
    "node": ">=24.0.0"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "CHANGELOG.md",
    "README.md"
  ],
  "main": "./dist/server/index.js",
  "types": "./dist/server/index.d.ts",
  "exports": {
    ".": {
      "types": "./server/index.ts",
      "import": "./server/index.ts"
    },
    "./server": {
      "types": "./server/index.ts",
      "import": "./server/index.ts"
    },
    "./email": {
      "types": "./server/email/index.ts",
      "import": "./server/email/index.ts"
    },
    "./im": {
      "types": "./server/im/index.ts",
      "import": "./server/im/index.ts"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/server/index.d.ts",
        "import": "./dist/server/index.js"
      },
      "./server": {
        "types": "./dist/server/index.d.ts",
        "import": "./dist/server/index.js"
      },
      "./email": {
        "types": "./dist/server/email/index.d.ts",
        "import": "./dist/server/email/index.js"
      },
      "./im": {
        "types": "./dist/server/im/index.d.ts",
        "import": "./dist/server/im/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "clean": "node ./scripts/clean-dist.mjs",
    "build": "node ./scripts/clean-dist.mjs && tsc -p tsconfig.json",
    "prepack": "pnpm build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.type-tests.json --noEmit",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
    "fix": "pnpm lint:fix && pnpm format"
  },
  "dependencies": {
    "nodemailer": "^9.0.5",
    "resend": "^6.22.1"
  },
  "peerDependencies": {
    "@nocobase/app-plugin-notification": "workspace:^",
    "@nocobase/app-server": "workspace:^",
    "@nocobase/i18n": "workspace:^",
    "@nocobase/service-provider": "workspace:^"
  },
  "devDependencies": {
    "@nocobase/dev-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/nodemailer": "^8.0.1",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
