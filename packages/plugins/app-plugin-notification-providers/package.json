{
  "name": "@nocobase/app-plugin-notification-providers",
  "displayName": "Notification Providers App Plugin",
  "description": "Provides built-in notification Channels and Providers.",
  "version": "1.0.0-beta.21",
  "type": "module",
  "prettier": "@nocobase/dev-config/prettier",
  "engines": {
    "node": ">=24.0.0"
  },
  "nocobase": {
    "pluginPolicy": "preinstall-and-enable",
    "title": {
      "en-US": "Notification channels",
      "zh-CN": "通知渠道"
    },
    "description": {
      "en-US": "Email, IM and other delivery channels",
      "zh-CN": "邮件、IM 等发送渠道"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "CHANGELOG.md",
    "README.md",
    "skills"
  ],
  "main": "./dist/server/index.js",
  "types": "./dist/server/index.d.ts",
  "exports": {
    ".": {
      "types": "./server/index.ts",
      "import": "./server/index.ts"
    },
    "./server": {
      "types": "./server/index.ts",
      "import": "./server/index.ts"
    },
    "./email": {
      "types": "./server/email/index.ts",
      "import": "./server/email/index.ts"
    },
    "./im": {
      "types": "./server/im/index.ts",
      "import": "./server/im/index.ts"
    },
    "./package.json": "./package.json",
    "./config": {
      "types": "./server/email/config.ts",
      "import": "./server/email/config.ts"
    },
    "./sms": {
      "types": "./server/sms/index.ts",
      "import": "./server/sms/index.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/server/index.d.ts",
        "import": "./dist/server/index.js"
      },
      "./server": {
        "types": "./dist/server/index.d.ts",
        "import": "./dist/server/index.js"
      },
      "./email": {
        "types": "./dist/server/email/index.d.ts",
        "import": "./dist/server/email/index.js"
      },
      "./im": {
        "types": "./dist/server/im/index.d.ts",
        "import": "./dist/server/im/index.js"
      },
      "./package.json": "./package.json",
      "./config": {
        "types": "./dist/server/email/config.d.ts",
        "import": "./dist/server/email/config.js"
      },
      "./sms": {
        "types": "./dist/server/sms/index.d.ts",
        "import": "./dist/server/sms/index.js"
      }
    }
  },
  "scripts": {
    "clean": "node ./scripts/clean-dist.mjs",
    "build": "node ./scripts/clean-dist.mjs && tsc -p tsconfig.json",
    "prepack": "pnpm build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.type-tests.json --noEmit",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
    "fix": "pnpm lint:fix && pnpm format"
  },
  "dependencies": {
    "@nocobase/mailer": "workspace:^"
  },
  "peerDependencies": {
    "@nocobase/app-plugin-authentication": "workspace:^",
    "@nocobase/app-plugin-notification": "workspace:^",
    "@nocobase/app-server": "workspace:^",
    "@nocobase/i18n": "workspace:^",
    "@nocobase/service-provider": "workspace:^"
  },
  "devDependencies": {
    "@nocobase/app-testing": "workspace:*",
    "@nocobase/db": "workspace:*",
    "@nocobase/dev-config": "workspace:*",
    "@nocobase/jobs": "workspace:*",
    "@nocobase/logging": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "nodemailer": "^10.1.4",
    "prettier": "catalog:",
    "resend": "^6.22.1",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
