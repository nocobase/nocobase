{
  "name": "@nocobase/app-plugin-ai-employee",
  "displayName": "AI Employee App Plugin",
  "description": "Database-backed AI employee runtime, routes, resources, and built-in employees for NocoBase Apps.",
  "version": "3.0.0-beta",
  "type": "module",
  "prettier": "@nocobase/dev-config/prettier",
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "ai",
    "package.json",
    "README.md",
    "CHANGELOG.md",
    "registry",
    "registry.config.json",
    "public/r",
    "skills"
  ],
  "exports": {
    ".": {
      "types": "./index.ts",
      "import": "./index.ts"
    },
    "./cli": {
      "types": "./cli/index.ts",
      "import": "./cli/index.ts"
    },
    "./server": {
      "types": "./server/index.ts",
      "import": "./server/index.ts"
    },
    "./package.json": "./package.json",
    "./client": {
      "types": "./client/index.ts",
      "import": "./client/index.ts"
    },
    "./client/plugin": {
      "types": "./client/plugin.ts",
      "import": "./client/plugin.ts"
    },
    "./client/routes": {
      "types": "./client/routes.ts",
      "import": "./client/routes.ts"
    },
    "./client/ai-settings": {
      "types": "./client/ai-settings.ts",
      "import": "./client/ai-settings.ts"
    },
    "./client/settings": {
      "types": "./client/settings.ts",
      "import": "./client/settings.ts"
    },
    "./client/settings-pages": {
      "types": "./client/settings-pages.ts",
      "import": "./client/settings-pages.ts"
    },
    "./server/plugin": {
      "types": "./server/plugin.ts",
      "import": "./server/plugin.ts"
    },
    "./server/config": {
      "types": "./server/config.ts",
      "import": "./server/config.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./cli": {
        "types": "./dist/cli/index.d.ts",
        "import": "./dist/cli/index.js"
      },
      "./server": {
        "types": "./dist/server/index.d.ts",
        "import": "./dist/server/index.js"
      },
      "./package.json": "./package.json",
      "./client": {
        "types": "./dist/client/index.d.ts",
        "import": "./dist/client/index.js"
      },
      "./client/routes": {
        "types": "./dist/client/routes.d.ts",
        "import": "./dist/client/routes.js"
      },
      "./client/ai-settings": {
        "types": "./dist/client/ai-settings.d.ts",
        "import": "./dist/client/ai-settings.js"
      },
      "./client/settings": {
        "types": "./dist/client/settings.d.ts",
        "import": "./dist/client/settings.js"
      },
      "./client/plugin": {
        "types": "./dist/client/plugin.d.ts",
        "import": "./dist/client/plugin.js"
      },
      "./client/settings-pages": {
        "types": "./dist/client/settings-pages.d.ts",
        "import": "./dist/client/settings-pages.js"
      },
      "./server/plugin": {
        "types": "./dist/server/plugin.d.ts",
        "import": "./dist/server/plugin.js"
      },
      "./server/config": {
        "types": "./dist/server/config.d.ts",
        "import": "./dist/server/config.js"
      }
    }
  },
  "nocobase": {
    "plugin": {
      "database": {
        "migrations": "./database/migrations"
      }
    },
    "registry": {
      "items": {
        "nocobase-ai": "./registry/nocobase-ai"
      }
    }
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "pnpm clean && tsc -p tsconfig.json && nocobase-db-manifests && node -e \"require('node:fs').cpSync('ai/skills', 'dist/ai/skills', { recursive: true })\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm typecheck:registry && pnpm test && pnpm registry:build && pnpm build",
    "fix": "pnpm lint:fix && pnpm format",
    "registry:build": "node ../../../scripts/registry.mjs build --package .",
    "registry:materialize": "node ../../../scripts/registry.mjs materialize --package .",
    "prepack": "pnpm registry:build && pnpm build",
    "typecheck:registry": "tsc -p tsconfig.registry.json --noEmit"
  },
  "dependencies": {
    "@ai-sdk/react": "^2.0.0",
    "@langchain/core": "1.1.49",
    "@langchain/langgraph": "1.4.4",
    "@langchain/langgraph-checkpoint": "1.1.2",
    "@nocobase/ai-employee-avatars": "^1.0.2",
    "@nocobase/drive": "workspace:^",
    "@nocobase/logging": "workspace:^",
    "@nocobase/snowflake": "workspace:^",
    "@sinclair/typebox": "catalog:",
    "ai": "^5.0.0",
    "eventsource-parser": "^3.0.0",
    "hono": "catalog:",
    "langchain": "1.2.39",
    "lodash": "^4.17.21",
    "remark-gfm": "^4.0.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@langchain/openai": "1.4.7",
    "@nocobase/app-plugin-authz-restriction-rules": "workspace:*",
    "@nocobase/app-testing": "workspace:*",
    "@nocobase/dev-config": "workspace:*",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/lodash": "^4.17.0",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "better-sqlite3": "catalog:",
    "eslint": "catalog:",
    "jsdom": "catalog:",
    "prettier": "catalog:",
    "shadcn": "catalog:",
    "tailwindcss": "catalog:",
    "tw-animate-css": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@base-ui/react": "catalog:",
    "@dicebear/core": "^9.4.3",
    "@nocobase/app-cli": "workspace:^",
    "@nocobase/app-client": "workspace:^",
    "@nocobase/app-plugin-authentication": "workspace:^",
    "@nocobase/app-plugin-authorization": "workspace:^",
    "@nocobase/app-server": "workspace:^",
    "@nocobase/db": "workspace:^",
    "@nocobase/i18n": "workspace:^",
    "@nocobase/service-provider": "workspace:^",
    "@oclif/core": "catalog:",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "echarts": "^5.5.0",
    "echarts-for-react": "^3.0.2",
    "lucide-react": "catalog:",
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.57.0",
    "react-markdown": "^10.1.0",
    "react-router": "^7.0.0",
    "tailwind-merge": "catalog:",
    "@nocobase/caching": "workspace:^",
    "@nocobase/ai-employee": "workspace:^"
  }
}
