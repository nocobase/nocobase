{
  "extends": "@nocobase/dev-config/tsconfig/server-library.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./client/*"]
    },
    "isolatedDeclarations": false,
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"]
  },
  "include": [
    "index.ts",
    "cli/**/*.ts",
    "client/**/*.ts",
    "client/**/*.tsx",
    "ai/**/*.ts",
    "server/**/*.ts",
    "shared/**/*.ts",
    "database/**/*.ts",
    "types/**/*.d.ts"
  ],
  "exclude": ["dist", "node_modules"]
}
