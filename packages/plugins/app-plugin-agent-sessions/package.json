{
  "name": "@nocobase/app-plugin-agent-sessions",
  "displayName": "Agent Sessions App Plugin",
  "description": "Conversations in the browser with coding agents that run on people's own computers over the Agent Client Protocol, with their transcripts and the work they create kept in the application.",
  "version": "1.0.0-beta.12",
  "type": "module",
  "prettier": "@nocobase/dev-config/prettier",
  "engines": {
    "node": ">=24.0.0"
  },
  "sideEffects": false,
  "exports": {
    "./server": {
      "types": "./server/index.ts",
      "import": "./server/index.ts"
    },
    "./server/tokens": {
      "types": "./server/tokens.ts",
      "import": "./server/tokens.ts"
    },
    "./client": {
      "types": "./client/index.ts",
      "import": "./client/index.ts"
    },
    "./client/plugin": {
      "types": "./client/plugin.ts",
      "import": "./client/plugin.ts"
    },
    "./client/routes": {
      "types": "./client/routes.ts",
      "import": "./client/routes.ts"
    },
    "./client/panel": {
      "types": "./client/panel.ts",
      "import": "./client/panel.ts"
    },
    "./package.json": "./package.json",
    "./shared/api": {
      "types": "./shared/api.ts",
      "import": "./shared/api.ts"
    }
  },
  "imports": {
    "#components/*": {
      "development": "./client/components/*.js",
      "default": "./dist/client/components/*.js"
    },
    "#hooks/*": {
      "development": "./client/hooks/*.js",
      "default": "./dist/client/hooks/*.js"
    },
    "#lib/*": {
      "development": "./client/lib/*.js",
      "default": "./dist/client/lib/*.js"
    },
    "#extensions/*": {
      "development": "./client/extensions/*.js",
      "default": "./dist/client/extensions/*.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "skills"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      "./server": {
        "types": "./dist/server/index.d.ts",
        "import": "./dist/server/index.js"
      },
      "./server/tokens": {
        "types": "./dist/server/tokens.d.ts",
        "import": "./dist/server/tokens.js"
      },
      "./client": {
        "types": "./dist/client/index.d.ts",
        "import": "./dist/client/index.js"
      },
      "./client/plugin": {
        "types": "./dist/client/plugin.d.ts",
        "import": "./dist/client/plugin.js"
      },
      "./client/routes": {
        "types": "./dist/client/routes.d.ts",
        "import": "./dist/client/routes.js"
      },
      "./client/panel": {
        "types": "./dist/client/panel.d.ts",
        "import": "./dist/client/panel.js"
      },
      "./package.json": "./package.json",
      "./shared/api": {
        "types": "./dist/shared/api.d.ts",
        "import": "./dist/shared/api.js"
      }
    },
    "imports": {
      "#components/*": "./dist/client/components/*.js",
      "#hooks/*": "./dist/client/hooks/*.js",
      "#lib/*": "./dist/client/lib/*.js",
      "#extensions/*": "./dist/client/extensions/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && nocobase-db-manifests",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
    "fix": "pnpm lint:fix && pnpm format"
  },
  "dependencies": {
    "@nocobase/acp-bridge": "workspace:^",
    "@nocobase/agent-protocol": "workspace:^",
    "hono": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "@base-ui/react": "catalog:",
    "@nocobase/app-client": "workspace:^",
    "@nocobase/app-plugin-authentication": "workspace:^",
    "@nocobase/app-plugin-file": "workspace:^",
    "@nocobase/app-server": "workspace:^",
    "@nocobase/db": "workspace:^",
    "@nocobase/i18n": "workspace:^",
    "@nocobase/service-provider": "workspace:^",
    "@tanstack/react-query": "catalog:",
    "class-variance-authority": "catalog:",
    "cn": "catalog:",
    "lucide-react": "catalog:",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "catalog:",
    "react-router": "^7.0.0",
    "remark-gfm": "catalog:"
  },
  "devDependencies": {
    "@nocobase/app-testing": "workspace:*",
    "@nocobase/dev-config": "workspace:*",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "eslint": "catalog:",
    "jsdom": "catalog:",
    "prettier": "catalog:",
    "shadcn": "catalog:",
    "tailwindcss": "catalog:",
    "tw-animate-css": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
