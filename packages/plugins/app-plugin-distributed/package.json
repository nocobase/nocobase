{
  "name": "@nocobase/app-plugin-distributed",
  "displayName": "Distributed App Plugin",
  "description": "Shows whether an application can run on several instances, with the Agent Skills to configure it.",
  "version": "0.1.0-beta.1",
  "type": "module",
  "prettier": "@nocobase/dev-config/prettier",
  "engines": {
    "node": ">=24.0.0"
  },
  "sideEffects": false,
  "exports": {
    "./server": {
      "types": "./server/index.ts",
      "import": "./server/index.ts"
    },
    "./client": {
      "types": "./client/index.ts",
      "import": "./client/index.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      "./server": {
        "types": "./dist/server/index.d.ts",
        "import": "./dist/server/index.js"
      },
      "./client": {
        "types": "./dist/client/index.d.ts",
        "import": "./dist/client/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
    "fix": "pnpm lint:fix && pnpm format"
  },
  "dependencies": {
    "hono": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "@nocobase/app-client": "workspace:^",
    "@nocobase/app-plugin-authentication": "workspace:^",
    "@nocobase/app-plugin-authorization": "workspace:^",
    "@nocobase/app-plugin-concurrency": "workspace:^",
    "@nocobase/app-plugin-file": "workspace:^",
    "@nocobase/app-server": "workspace:^",
    "@nocobase/i18n": "workspace:^",
    "@nocobase/service-provider": "workspace:^",
    "lucide-react": "catalog:",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@nocobase/app-testing": "workspace:*",
    "@nocobase/dev-config": "workspace:*",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nocobase/nocobase.git",
    "directory": "packages/plugins/app-plugin-distributed"
  }
}
