{
  "name": "@nocobase/plugin-js-template",
  "displayName": "JS Templates",
  "displayName.zh-CN": "JS 模板",
  "description": "Organize and reuse multi-file RunJS templates from Source Projects.",
  "description.zh-CN": "组织并复用 JS 模板项目中的多文件 RunJS 模板。",
  "version": "3.0.0-alpha.9",
  "license": "Apache-2.0",
  "main": "./dist/server/index.js",
  "files": [
    "dist",
    "src/swagger",
    "client-v2.d.ts",
    "client-v2.js",
    "client.d.ts",
    "client.js",
    "server.d.ts",
    "server.js"
  ],
  "exports": {
    ".": {
      "types": "./server.d.ts",
      "import": "./dist/server/index.js",
      "require": "./dist/server/index.js"
    },
    "./client": {
      "types": "./client.d.ts",
      "import": "./client.js",
      "require": "./client.js"
    },
    "./client-v2": {
      "types": "./client-v2.d.ts",
      "import": "./client-v2.js",
      "require": "./client-v2.js"
    },
    "./server": {
      "types": "./server.d.ts",
      "import": "./server.js",
      "require": "./server.js"
    },
    "./src/swagger": "./src/swagger/index.ts",
    "./src/swagger/index.ts": "./src/swagger/index.ts",
    "./dist/swagger": "./dist/swagger/index.js",
    "./dist/swagger/index.js": "./dist/swagger/index.js",
    "./package.json": "./package.json"
  },
  "homepage": "https://docs.nocobase.com",
  "homepage.zh-CN": "https://docs-cn.nocobase.com",
  "keywords": [
    "Developer tools"
  ],
  "dependencies": {
    "@nocobase/runjs": "3.0.0-alpha.9",
    "dayjs": "^1.11.10",
    "ipaddr.js": "^1.9.1",
    "jszip": "^3.10.1",
    "typescript": "5.1.3"
  },
  "devDependencies": {
    "@formily/core": "2.x",
    "@formily/react": "2.x",
    "react-router-dom": "^6.11.2"
  },
  "peerDependencies": {
    "@ant-design/icons": "5.x",
    "@nocobase/acl": "2.x",
    "@nocobase/actions": "2.x",
    "@nocobase/client": "2.x",
    "@nocobase/client-v2": "2.x",
    "@nocobase/database": "2.x",
    "@nocobase/flow-engine": "2.x",
    "@nocobase/plugin-flow-engine": "2.x",
    "@nocobase/plugin-environment-variables": "2.x",
    "@nocobase/resourcer": "2.x",
    "@nocobase/server": "2.x",
    "@nocobase/test": "2.x",
    "@nocobase/utils": "2.x",
    "antd": "5.x",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^11.15.1"
  }
}
