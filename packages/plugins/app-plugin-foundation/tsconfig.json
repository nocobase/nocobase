{
  "extends": "@nocobase/dev-config/tsconfig/server-library.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "customConditions": ["development"],
    "rootDir": ".",
    "outDir": "dist"
  },
  "include": [
    "package.ts",
    "shared/**/*.ts",
    "server/**/*.ts",
    "client/**/*.ts",
    "client/**/*.tsx"
  ]
}
