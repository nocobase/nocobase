{
  "name": "@nocobase/app-plugin-foundation",
  "displayName": "App Foundation",
  "description": "Shows which NocoBase Core capabilities an application uses, with live evidence, for its unrestricted administrators.",
  "version": "0.1.0-beta.6",
  "type": "module",
  "prettier": "@nocobase/dev-config/prettier",
  "engines": {
    "node": ">=24.0.0"
  },
  "sideEffects": false,
  "exports": {
    "./server": {
      "types": "./server/index.ts",
      "import": "./server/index.ts"
    },
    "./client": {
      "types": "./client/index.ts",
      "import": "./client/index.ts"
    },
    "./client/plugin": {
      "types": "./client/plugin.ts",
      "import": "./client/plugin.ts"
    },
    "./client/routes": {
      "types": "./client/routes.ts",
      "import": "./client/routes.ts"
    },
    "./client/pages": {
      "types": "./client/components/foundation-page.tsx",
      "import": "./client/components/foundation-page.tsx"
    },
    "./cli": {
      "types": "./cli/index.ts",
      "import": "./cli/index.ts"
    },
    "./package.json": "./package.json"
  },
  "imports": {
    "#components/*": {
      "development": "./client/components/*.js",
      "default": "./dist/client/components/*.js"
    },
    "#hooks/*": {
      "development": "./client/hooks/*.js",
      "default": "./dist/client/hooks/*.js"
    },
    "#lib/*": {
      "development": "./client/lib/*.js",
      "default": "./dist/client/lib/*.js"
    },
    "#extensions/*": {
      "development": "./client/extensions/*.js",
      "default": "./dist/client/extensions/*.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "skills"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      "./server": {
        "types": "./dist/server/index.d.ts",
        "import": "./dist/server/index.js"
      },
      "./client": {
        "types": "./dist/client/index.d.ts",
        "import": "./dist/client/index.js"
      },
      "./client/plugin": {
        "types": "./dist/client/plugin.d.ts",
        "import": "./dist/client/plugin.js"
      },
      "./client/routes": {
        "types": "./dist/client/routes.d.ts",
        "import": "./dist/client/routes.js"
      },
      "./client/pages": {
        "types": "./dist/client/components/foundation-page.d.ts",
        "import": "./dist/client/components/foundation-page.js"
      },
      "./cli": {
        "types": "./dist/cli/index.d.ts",
        "import": "./dist/cli/index.js"
      },
      "./package.json": "./package.json"
    },
    "imports": {
      "#components/*": "./dist/client/components/*.js",
      "#hooks/*": "./dist/client/hooks/*.js",
      "#lib/*": "./dist/client/lib/*.js",
      "#extensions/*": "./dist/client/extensions/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
    "fix": "pnpm lint:fix && pnpm format"
  },
  "dependencies": {
    "hono": "catalog:",
    "zod": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@base-ui/react": "catalog:",
    "@nocobase/app-cli": "workspace:^",
    "@nocobase/app-client": "workspace:^",
    "@nocobase/app-plugin-authentication": "workspace:^",
    "@nocobase/app-plugin-authorization": "workspace:^",
    "@nocobase/app-server": "workspace:^",
    "@nocobase/db": "workspace:^",
    "@nocobase/i18n": "workspace:^",
    "@nocobase/service-provider": "workspace:^",
    "@tanstack/react-query": "catalog:",
    "class-variance-authority": "catalog:",
    "cn": "catalog:",
    "lucide-react": "catalog:",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@nocobase/app-plugin-api-keys": "workspace:*",
    "@nocobase/app-plugin-mail": "workspace:*",
    "@nocobase/app-plugin-notification": "workspace:*",
    "@nocobase/app-plugin-notification-in-app": "workspace:*",
    "@nocobase/app-plugin-scheduler": "workspace:*",
    "@nocobase/app-testing": "workspace:*",
    "@nocobase/dev-config": "workspace:*",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "eslint": "catalog:",
    "jsdom": "catalog:",
    "prettier": "catalog:",
    "react-dom": "catalog:",
    "react-router": "catalog:",
    "shadcn": "catalog:",
    "tailwindcss": "catalog:",
    "tw-animate-css": "catalog:",
    "vitest": "catalog:"
  }
}
