{
  "name": "@nocobase/app-plugin-hub",
  "displayName": "Application Hub",
  "description": "Create, configure, release, and deploy applications through a managed app host.",
  "version": "2.0.0-beta",
  "type": "module",
  "prettier": "@nocobase/dev-config/prettier",
  "engines": {
    "node": ">=24.0.0"
  },
  "sideEffects": false,
  "exports": {
    "./server": {
      "types": "./server/index.ts",
      "import": "./server/index.ts"
    },
    "./server/tokens": {
      "types": "./server/tokens.ts",
      "import": "./server/tokens.ts"
    },
    "./client": {
      "types": "./client/index.ts",
      "import": "./client/index.ts"
    },
    "./client/plugin": {
      "types": "./client/plugin.ts",
      "import": "./client/plugin.ts"
    },
    "./client/routes": {
      "types": "./client/routes.ts",
      "import": "./client/routes.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "skills"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      "./server": {
        "types": "./dist/server/index.d.ts",
        "import": "./dist/server/index.js"
      },
      "./server/tokens": {
        "types": "./dist/server/tokens.d.ts",
        "import": "./dist/server/tokens.js"
      },
      "./client": {
        "types": "./dist/client/index.d.ts",
        "import": "./dist/client/index.js"
      },
      "./client/plugin": {
        "types": "./dist/client/plugin.d.ts",
        "import": "./dist/client/plugin.js"
      },
      "./client/routes": {
        "types": "./dist/client/routes.d.ts",
        "import": "./dist/client/routes.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && nocobase-db-manifests",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
    "fix": "pnpm lint:fix && pnpm format"
  },
  "dependencies": {
    "@nocobase/app-host": "workspace:^",
    "@nocobase/drive": "workspace:^",
    "@nocobase/logging": "workspace:^",
    "@sinclair/typebox": "catalog:",
    "better-auth": "catalog:",
    "hono": "catalog:",
    "tar": "catalog:",
    "yaml": "^2.8.1",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "@base-ui/react": "catalog:",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/state": "^6.7.2",
    "@codemirror/view": "^6.43.10",
    "@nocobase/app-client": "workspace:^",
    "@nocobase/app-plugin-authentication": "workspace:^",
    "@nocobase/app-plugin-authorization": "workspace:^",
    "@nocobase/app-plugin-users": "workspace:^",
    "@nocobase/app-server": "workspace:^",
    "@nocobase/db": "workspace:^",
    "@nocobase/i18n": "workspace:^",
    "@nocobase/service-provider": "workspace:^",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "codemirror": "^6.0.2",
    "lucide-react": "catalog:",
    "react": "^19.0.0",
    "react-router": "catalog:",
    "tailwind-merge": "catalog:",
    "@nocobase/app-plugin-api-keys": "workspace:^",
    "@nocobase/authorization": "workspace:^",
    "react-day-picker": "10.0.1"
  },
  "devDependencies": {
    "@nocobase/app-testing": "workspace:*",
    "@nocobase/dev-config": "workspace:*",
    "@nocobase/hub-cli": "workspace:*",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "eslint": "catalog:",
    "jsdom": "catalog:",
    "knex": "catalog:",
    "prettier": "catalog:",
    "shadcn": "catalog:",
    "tailwindcss": "catalog:",
    "tw-animate-css": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
