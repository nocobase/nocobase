{
  "name": "@nocobase/app-plugin-notification-in-app",
  "displayName": "In-app Notification App Plugin",
  "description": "Provides an authenticated in-app inbox, notification Channel, and development-only Client inbox page.",
  "version": "0.2.0-beta.19",
  "type": "module",
  "prettier": "@nocobase/dev-config/prettier",
  "engines": {
    "node": ">=24.0.0"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "CHANGELOG.md",
    "README.md",
    "skills"
  ],
  "main": "./dist/server/index.js",
  "types": "./dist/server/index.d.ts",
  "exports": {
    ".": {
      "types": "./server/index.ts",
      "import": "./server/index.ts"
    },
    "./server": {
      "types": "./server/index.ts",
      "import": "./server/index.ts"
    },
    "./client": {
      "types": "./client/index.ts",
      "import": "./client/index.ts"
    },
    "./client/plugin": {
      "types": "./client/plugin.ts",
      "import": "./client/plugin.ts"
    },
    "./client/routes": {
      "types": "./client/routes.ts",
      "import": "./client/routes.ts"
    },
    "./realtime": {
      "types": "./shared/realtime.ts",
      "import": "./shared/realtime.ts"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/server/index.d.ts",
        "import": "./dist/server/index.js"
      },
      "./server": {
        "types": "./dist/server/index.d.ts",
        "import": "./dist/server/index.js"
      },
      "./client": {
        "types": "./dist/client/index.d.ts",
        "import": "./dist/client/index.js"
      },
      "./client/plugin": {
        "types": "./dist/client/plugin.d.ts",
        "import": "./dist/client/plugin.js"
      },
      "./client/routes": {
        "types": "./dist/client/routes.d.ts",
        "import": "./dist/client/routes.js"
      },
      "./realtime": {
        "types": "./dist/shared/realtime.d.ts",
        "import": "./dist/shared/realtime.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "clean": "node ./scripts/clean-dist.mjs",
    "build": "node ./scripts/clean-dist.mjs && tsc -p tsconfig.json && nocobase-db-manifests",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepack": "pnpm build",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
    "fix": "pnpm lint:fix && pnpm format"
  },
  "dependencies": {
    "better-auth": "catalog:",
    "hono": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nocobase/app-testing": "workspace:*",
    "@nocobase/dev-config": "workspace:*",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "eslint": "catalog:",
    "jsdom": "catalog:",
    "prettier": "catalog:",
    "shadcn": "catalog:",
    "tailwindcss": "catalog:",
    "tw-animate-css": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@base-ui/react": "catalog:",
    "@nocobase/app-client": "workspace:^",
    "@nocobase/app-plugin-authentication": "workspace:^",
    "@nocobase/app-plugin-notification": "workspace:^",
    "@nocobase/app-server": "workspace:^",
    "@nocobase/db": "workspace:^",
    "@nocobase/i18n": "workspace:^",
    "@nocobase/service-provider": "workspace:^",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "lucide-react": "catalog:",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.0.0",
    "tailwind-merge": "catalog:"
  }
}
