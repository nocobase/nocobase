{
  "name": "@nocobase/app-plugin-authorization",
  "displayName": "Authorization App Plugin",
  "description": "Authorization integration and permission management UI for NocoBase applications.",
  "version": "1.0.0-beta.24",
  "type": "module",
  "sideEffects": false,
  "prettier": "@nocobase/dev-config/prettier",
  "engines": {
    "node": ">=24.0.0"
  },
  "exports": {
    ".": {
      "types": "./server/index.ts",
      "import": "./server/index.ts"
    },
    "./server": {
      "types": "./server/index.ts",
      "import": "./server/index.ts"
    },
    "./client": {
      "types": "./client/index.ts",
      "import": "./client/index.ts"
    },
    "./client/plugin": {
      "types": "./client/plugin.ts",
      "import": "./client/plugin.ts"
    },
    "./client/routes": {
      "types": "./client/routes.ts",
      "import": "./client/routes.ts"
    },
    "./client/react-providers": {
      "types": "./client/react-providers.ts",
      "import": "./client/react-providers.ts"
    },
    "./package.json": "./package.json",
    "./client/management": {
      "types": "./client/management.ts",
      "import": "./client/management.ts"
    },
    "./server/extension": {
      "types": "./server/extension/index.ts",
      "import": "./server/extension/index.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "skills"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/server/index.d.ts",
        "import": "./dist/server/index.js"
      },
      "./server": {
        "types": "./dist/server/index.d.ts",
        "import": "./dist/server/index.js"
      },
      "./client": {
        "types": "./dist/client/index.d.ts",
        "import": "./dist/client/index.js"
      },
      "./client/plugin": {
        "types": "./dist/client/plugin.d.ts",
        "import": "./dist/client/plugin.js"
      },
      "./client/routes": {
        "types": "./dist/client/routes.d.ts",
        "import": "./dist/client/routes.js"
      },
      "./client/react-providers": {
        "types": "./dist/client/react-providers.d.ts",
        "import": "./dist/client/react-providers.js"
      },
      "./package.json": "./package.json",
      "./client/management": {
        "types": "./dist/client/management.d.ts",
        "import": "./dist/client/management.js"
      },
      "./server/extension": {
        "types": "./dist/server/extension/index.d.ts",
        "import": "./dist/server/extension/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && nocobase-db-manifests",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm test:types",
    "test": "vitest run --passWithNoTests",
    "prepack": "pnpm build",
    "pack:check": "pnpm pack --out \"$PACK_DIR/nocobase-app-plugin-authorization.tgz\" && pnpm exec publint .",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
    "fix": "pnpm lint:fix && pnpm format",
    "test:types": "tsc -p tests/tsconfig.json"
  },
  "dependencies": {
    "hono": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "@base-ui/react": "catalog:",
    "@nocobase/app-client": "workspace:^",
    "@nocobase/app-plugin-authentication": "workspace:^",
    "@nocobase/app-server": "workspace:^",
    "@nocobase/db": "workspace:^",
    "@nocobase/i18n": "workspace:^",
    "@nocobase/service-provider": "workspace:^",
    "class-variance-authority": "catalog:",
    "cn": "catalog:",
    "lucide-react": "catalog:",
    "react": "^19.0.0",
    "react-router": "catalog:",
    "@nocobase/authorization": "workspace:^"
  },
  "devDependencies": {
    "@nocobase/app-testing": "workspace:*",
    "@nocobase/dev-config": "workspace:*",
    "@nocobase/repository-input": "workspace:*",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "better-sqlite3": "catalog:",
    "eslint": "catalog:",
    "jsdom": "catalog:",
    "knex": "catalog:",
    "prettier": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
