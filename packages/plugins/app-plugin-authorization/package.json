{
  "name": "@nocobase/app-plugin-authorization",
  "displayName": "Authorization App Plugin",
  "description": "Authorization integration and permission management UI for NocoBase applications.",
  "version": "1.0.0-beta.42",
  "type": "module",
  "sideEffects": false,
  "prettier": "@nocobase/dev-config/prettier",
  "engines": {
    "node": ">=24.0.0"
  },
  "nocobase": {
    "pluginPolicy": "preinstall-and-enable",
    "title": {
      "en-US": "Roles & permissions",
      "zh-CN": "角色与权限"
    },
    "description": {
      "en-US": "Roles, permissions and access checks",
      "zh-CN": "角色、权限和授权检查"
    }
  },
  "exports": {
    ".": {
      "types": "./server/index.ts",
      "import": "./server/index.ts"
    },
    "./server": {
      "types": "./server/index.ts",
      "import": "./server/index.ts"
    },
    "./client": {
      "types": "./client/index.ts",
      "import": "./client/index.ts"
    },
    "./client/plugin": {
      "types": "./client/plugin.ts",
      "import": "./client/plugin.ts"
    },
    "./client/react-providers": {
      "types": "./client/react-providers.ts",
      "import": "./client/react-providers.ts"
    },
    "./package.json": "./package.json",
    "./server/extension": {
      "types": "./server/extension/index.ts",
      "import": "./server/extension/index.ts"
    },
    "./client/settings": {
      "types": "./client/settings/index.ts",
      "import": "./client/settings/index.ts"
    },
    "./cli": {
      "types": "./cli/index.ts",
      "import": "./cli/index.ts"
    }
  },
  "imports": {
    "#components/*": {
      "development": "./client/components/*.js",
      "default": "./client/components/*.js"
    },
    "#hooks/*": {
      "development": "./client/hooks/*.js",
      "default": "./client/hooks/*.js"
    },
    "#lib/*": {
      "development": "./client/lib/*.js",
      "default": "./client/lib/*.js"
    },
    "#settings/*": {
      "development": "./client/settings/*.js",
      "default": "./client/settings/*.js"
    },
    "#components/data-table": {
      "development": "./client/components/data-table/index.js",
      "default": "./client/components/data-table/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "skills"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/server/index.d.ts",
        "import": "./dist/server/index.js"
      },
      "./server": {
        "types": "./dist/server/index.d.ts",
        "import": "./dist/server/index.js"
      },
      "./client": {
        "types": "./dist/client/index.d.ts",
        "import": "./dist/client/index.js"
      },
      "./client/plugin": {
        "types": "./dist/client/plugin.d.ts",
        "import": "./dist/client/plugin.js"
      },
      "./client/react-providers": {
        "types": "./dist/client/react-providers.d.ts",
        "import": "./dist/client/react-providers.js"
      },
      "./package.json": "./package.json",
      "./server/extension": {
        "types": "./dist/server/extension/index.d.ts",
        "import": "./dist/server/extension/index.js"
      },
      "./client/settings": {
        "types": "./dist/client/settings/index.d.ts",
        "import": "./dist/client/settings/index.js"
      },
      "./cli": {
        "types": "./dist/cli/index.d.ts",
        "import": "./dist/cli/index.js"
      }
    },
    "imports": {
      "#components/*": "./dist/client/components/*.js",
      "#hooks/*": "./dist/client/hooks/*.js",
      "#lib/*": "./dist/client/lib/*.js",
      "#settings/*": "./dist/client/settings/*.js",
      "#components/data-table": "./dist/client/components/data-table/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && nocobase-db-manifests",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm test:types",
    "test": "vitest run --passWithNoTests",
    "prepack": "pnpm build",
    "pack:check": "pnpm pack --out \"$PACK_DIR/nocobase-app-plugin-authorization.tgz\" && pnpm exec publint .",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
    "fix": "pnpm lint:fix && pnpm format",
    "test:types": "tsc -p tests/tsconfig.json"
  },
  "dependencies": {
    "hono": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "@base-ui/react": "catalog:",
    "@nocobase/app-cli": "workspace:^",
    "@nocobase/app-client": "workspace:^",
    "@nocobase/app-plugin-authentication": "workspace:^",
    "@nocobase/app-server": "workspace:^",
    "@nocobase/audit": "workspace:^",
    "@nocobase/authorization": "workspace:^",
    "@nocobase/db": "workspace:^",
    "@nocobase/i18n": "workspace:^",
    "@nocobase/service-provider": "workspace:^",
    "@oclif/core": "catalog:",
    "@tanstack/react-table": "catalog:",
    "class-variance-authority": "catalog:",
    "cn": "catalog:",
    "lucide-react": "catalog:",
    "react": "^19.0.0",
    "react-dom": "catalog:",
    "react-router": "catalog:"
  },
  "devDependencies": {
    "@nocobase/app-testing": "workspace:*",
    "@nocobase/dev-config": "workspace:*",
    "@nocobase/repository-input": "workspace:*",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "better-sqlite3": "catalog:",
    "eslint": "catalog:",
    "jsdom": "catalog:",
    "knex": "catalog:",
    "prettier": "catalog:",
    "react-dom": "catalog:",
    "shadcn": "catalog:",
    "tailwindcss": "catalog:",
    "tw-animate-css": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
