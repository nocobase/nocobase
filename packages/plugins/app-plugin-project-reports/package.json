{
  "name": "@nocobase/app-plugin-project-reports",
  "displayName": "Project Reports",
  "description": "Structured daily project reports collected on existing agent runners, with readable change summaries and historical metrics.",
  "version": "0.0.1",
  "type": "module",
  "sideEffects": false,
  "prettier": "@nocobase/dev-config/prettier",
  "engines": { "node": ">=24.0.0" },
  "exports": {
    "./server": { "types": "./server/index.ts", "import": "./server/index.ts" },
    "./server/tokens": { "types": "./server/tokens.ts", "import": "./server/tokens.ts" },
    "./client": { "types": "./client/index.ts", "import": "./client/index.ts" },
    "./shared/reports": { "types": "./shared/reports.ts", "import": "./shared/reports.ts" },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "CHANGELOG.md"],
  "publishConfig": {
    "access": "public",
    "exports": {
      "./server": { "types": "./dist/server/index.d.ts", "import": "./dist/server/index.js" },
      "./server/tokens": { "types": "./dist/server/tokens.d.ts", "import": "./dist/server/tokens.js" },
      "./client": { "types": "./dist/client/index.d.ts", "import": "./dist/client/index.js" },
      "./shared/reports": { "types": "./dist/shared/reports.d.ts", "import": "./dist/shared/reports.js" },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && nocobase-db-manifests",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "fix": "pnpm lint:fix && pnpm format"
  },
  "dependencies": { "hono": "catalog:", "zod": "catalog:" },
  "peerDependencies": {
    "@nocobase/agent-protocol": "workspace:^",
    "@nocobase/app-client": "workspace:^",
    "@nocobase/app-plugin-agents": "workspace:^",
    "@nocobase/app-plugin-authentication": "workspace:^",
    "@nocobase/app-plugin-authorization": "workspace:^",
    "@nocobase/app-plugin-projects": "workspace:^",
    "@nocobase/app-plugin-scheduler": "workspace:^",
    "@nocobase/app-server": "workspace:^",
    "@nocobase/db": "workspace:^",
    "@nocobase/i18n": "workspace:^",
    "@nocobase/service-provider": "workspace:^",
    "@tanstack/react-query": "catalog:",
    "lucide-react": "catalog:",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@nocobase/app-testing": "workspace:*",
    "@nocobase/dev-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
