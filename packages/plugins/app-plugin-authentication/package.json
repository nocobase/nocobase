{
  "name": "@nocobase/app-plugin-authentication",
  "displayName": "Authentication App Plugin",
  "description": "Authentication plugin for NocoBase applications.",
  "version": "2.0.0-beta.0",
  "type": "module",
  "sideEffects": false,
  "prettier": "@nocobase/dev-config/prettier",
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./index.ts",
      "import": "./index.ts"
    },
    "./server": {
      "types": "./server/index.ts",
      "import": "./server/index.ts"
    },
    "./testing": {
      "types": "./server/testing.ts",
      "import": "./server/testing.ts"
    },
    "./client": {
      "types": "./client/index.ts",
      "import": "./client/index.ts"
    },
    "./client/plugin": {
      "types": "./client/plugin.ts",
      "import": "./client/plugin.ts"
    },
    "./client/actions": {
      "types": "./client/actions/index.ts",
      "import": "./client/actions/index.ts"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./server": {
        "types": "./dist/server/index.d.ts",
        "import": "./dist/server/index.js"
      },
      "./testing": {
        "types": "./dist/server/testing.d.ts",
        "import": "./dist/server/testing.js"
      },
      "./client": {
        "types": "./dist/client/index.d.ts",
        "import": "./dist/client/index.js"
      },
      "./client/plugin": {
        "types": "./dist/client/plugin.d.ts",
        "import": "./dist/client/plugin.js"
      },
      "./client/actions": {
        "types": "./dist/client/actions/index.d.ts",
        "import": "./dist/client/actions/index.js"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "files": [
    "dist",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "skills"
  ],
  "scripts": {
    "clean": "node ./scripts/clean-dist.mjs",
    "build": "pnpm clean && tsc -p tsconfig.json && tsc -p tsconfig.migrations.json && nocobase-db-manifests",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.migrations.json --noEmit",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
    "fix": "pnpm lint:fix && pnpm format"
  },
  "peerDependencies": {
    "@nocobase/app-client": "workspace:^",
    "@nocobase/app-server": "workspace:^",
    "@nocobase/db": "workspace:^",
    "@nocobase/service-provider": "workspace:^",
    "react": "^19.0.0",
    "react-router": "^7.0.0",
    "@nocobase/caching": "workspace:^",
    "@nocobase/i18n": "workspace:^"
  },
  "dependencies": {
    "@nocobase/snowflake": "workspace:^",
    "@sinclair/typebox": "catalog:",
    "better-auth": "catalog:",
    "hono": "catalog:",
    "knex": "catalog:"
  },
  "devDependencies": {
    "@base-ui/react": "^1.6.0",
    "@nocobase/app-client": "workspace:*",
    "@nocobase/app-server": "workspace:*",
    "@nocobase/db": "workspace:*",
    "@nocobase/app-testing": "workspace:*",
    "@nocobase/dev-config": "workspace:*",
    "@nocobase/service-provider": "workspace:*",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "class-variance-authority": "^0.7.1",
    "eslint": "catalog:",
    "jsdom": "catalog:",
    "prettier": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router": "catalog:",
    "shadcn": "^4.13.1",
    "tailwindcss": "catalog:",
    "tw-animate-css": "^1.2.5",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
