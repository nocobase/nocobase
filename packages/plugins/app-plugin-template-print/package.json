    "url": "git+https://github.com/nocobase/nocobase.git",
    "directory": "packages/plugins/app-plugin-template-print"
  },
  "prettier": "@nocobase/dev-config/prettier",
  "exports": {
    "./package.json": "./package.json"
  },
