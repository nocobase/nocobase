{
  "name": "@nocobase/app-plugin-workflow",
  "displayName": "Workflow App Plugin",
  "description": "Adds workflow runtime, persistence, and HTTP APIs to a NocoBase app.",
  "version": "1.0.0-beta.31",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "prettier": "@nocobase/dev-config/prettier",
  "engines": {
    "node": ">=24.0.0"
  },
  "exports": {
    ".": {
      "types": "./index.ts",
      "import": "./index.ts"
    },
    "./client": {
      "types": "./client/index.ts",
      "import": "./client/index.ts"
    },
    "./cli": {
      "types": "./cli/index.ts",
      "import": "./cli/index.ts"
    },
    "./build": {
      "types": "./build/index.ts",
      "import": "./build/index.ts"
    },
    "./vite": {
      "types": "./build/vite.ts",
      "import": "./build/vite.ts"
    },
    "./server": {
      "types": "./server/index.ts",
      "import": "./server/index.ts"
    },
    "./server/config": {
      "types": "./server/config.ts",
      "import": "./server/config.ts"
    },
    "./package.json": "./package.json",
    "./dsl": {
      "types": "./dsl/index.ts",
      "import": "./dsl/index.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./client": {
        "types": "./dist/client/index.d.ts",
        "import": "./dist/client/index.js"
      },
      "./cli": {
        "types": "./dist/cli/index.d.ts",
        "import": "./dist/cli/index.js"
      },
      "./build": {
        "types": "./dist/build/index.d.ts",
        "import": "./dist/build/index.js"
      },
      "./vite": {
        "types": "./dist/build/vite.d.ts",
        "import": "./dist/build/vite.js"
      },
      "./server": {
        "types": "./dist/server/index.d.ts",
        "import": "./dist/server/index.js"
      },
      "./server/config": {
        "types": "./dist/server/config.d.ts",
        "import": "./dist/server/config.js"
      },
      "./package.json": "./package.json",
      "./dsl": {
        "types": "./dist/dsl/index.d.ts",
        "import": "./dist/dsl/index.js"
      }
    }
  },
  "files": [
    "dist",
    "skills"
  ],
  "scripts": {
    "clean": "node ./scripts/clean-dist.mjs",
    "build": "pnpm clean && tsc -p tsconfig.json && node ./scripts/copy-client-assets.mjs && tsc -p tsconfig.migrations.json && nocobase-db-manifests",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.migrations.json --noEmit && tsc -p tsconfig.skill-evals.json --noEmit && tsc -p tsconfig.workflow-fixtures.json --noEmit && tsc -p tests/dsl/types/tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:integration": "pnpm test:integration:sqlite",
    "test:integration:sqlite": "NOCOBASE_TEST_DB_DIALECT=sqlite vitest run tests/integration",
    "test:integration:postgres": "NOCOBASE_TEST_DB_DIALECT=postgres vitest run tests/integration",
    "test:integration:mysql": "NOCOBASE_TEST_DB_DIALECT=mysql vitest run tests/integration",
    "eval:skill": "node --import tsx skill-evals/nocobase3-workflow-manage/runner/cli.ts",
    "eval:skill:test": "vitest run --config skill-evals/nocobase3-workflow-manage/vitest.config.ts",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
    "fix": "pnpm lint:fix && pnpm format"
  },
  "dependencies": {
    "@nocobase/drive": "workspace:^",
    "@nocobase/logging": "workspace:^",
    "@sinclair/typebox": "catalog:",
    "hono": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "@base-ui/react": "catalog:",
    "@nocobase/app-cli": "workspace:^",
    "@nocobase/app-client": "workspace:^",
    "@nocobase/app-plugin-authentication": "workspace:^",
    "@nocobase/app-plugin-authorization": "workspace:^",
    "@nocobase/app-plugin-scheduler": "workspace:^",
    "@nocobase/app-server": "workspace:^",
    "@nocobase/db": "workspace:^",
    "@nocobase/i18n": "workspace:^",
    "@nocobase/jobs": "workspace:^",
    "@nocobase/service-provider": "workspace:^",
    "@oclif/core": "catalog:",
    "@xyflow/react": "^12.11.3",
    "elkjs": "^0.10.2",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-router": "catalog:",
    "tailwind-merge": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  },
  "peerDependenciesMeta": {
    "@nocobase/app-plugin-scheduler": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nocobase/db-sqlite": "workspace:*",
    "@nocobase/app-testing": "workspace:*",
    "@nocobase/dev-config": "workspace:*",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "eslint": "catalog:",
    "jsdom": "catalog:",
    "knex": "catalog:",
    "prettier": "catalog:",
    "react-dom": "catalog:",
    "vitest": "catalog:",
    "yaml": "catalog:"
  }
}
