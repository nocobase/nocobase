{
  "name": "@nocobase/app-plugin-modules",
  "displayName": "Modules App Plugin",
  "description": "Open-source module registration, lifecycle contracts and layout composition.",
  "version": "0.0.1",
  "type": "module",
  "prettier": "@nocobase/dev-config/prettier",
  "engines": {
    "node": ">=24.0.0"
  },
  "sideEffects": false,
  "exports": {
    "./server": {
      "types": "./server/index.ts",
      "import": "./server/index.ts"
    },
    "./server/tokens": {
      "types": "./server/tokens.ts",
      "import": "./server/tokens.ts"
    },
    "./package.json": "./package.json",
    "./client": {
      "types": "./client/index.ts",
      "import": "./client/index.ts"
    },
    "./shared": {
      "types": "./shared/types.ts",
      "import": "./shared/types.ts"
    }
  },
  "imports": {
    "#components/*": {
      "development": "./client/components/*.js",
      "default": "./dist/client/components/*.js"
    },
    "#hooks/*": {
      "development": "./client/hooks/*.js",
      "default": "./dist/client/hooks/*.js"
    },
    "#lib/*": {
      "development": "./client/lib/*.js",
      "default": "./dist/client/lib/*.js"
    },
    "#extensions/*": {
      "development": "./client/extensions/*.js",
      "default": "./dist/client/extensions/*.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      "./server": {
        "types": "./dist/server/index.d.ts",
        "import": "./dist/server/index.js"
      },
      "./server/tokens": {
        "types": "./dist/server/tokens.d.ts",
        "import": "./dist/server/tokens.js"
      },
      "./package.json": "./package.json",
      "./client": {
        "types": "./dist/client/index.d.ts",
        "import": "./dist/client/index.js"
      },
      "./shared": {
        "types": "./dist/shared/types.d.ts",
        "import": "./dist/shared/types.js"
      }
    },
    "imports": {
      "#components/*": "./dist/client/components/*.js",
      "#hooks/*": "./dist/client/hooks/*.js",
      "#lib/*": "./dist/client/lib/*.js",
      "#extensions/*": "./dist/client/extensions/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
    "fix": "pnpm lint:fix && pnpm format"
  },
  "peerDependencies": {
    "@nocobase/app-server": "workspace:^",
    "@nocobase/service-provider": "workspace:^",
    "react": "catalog:",
    "@nocobase/db": "workspace:^",
    "@nocobase/i18n": "workspace:^",
    "react-router": "catalog:",
    "lucide-react": "catalog:",
    "@nocobase/app-client": "workspace:^"
  },
  "devDependencies": {
    "@nocobase/app-testing": "workspace:*",
    "@nocobase/dev-config": "workspace:*",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "eslint": "catalog:",
    "jsdom": "catalog:",
    "prettier": "catalog:",
    "react-dom": "catalog:",
    "shadcn": "catalog:",
    "tailwindcss": "catalog:",
    "tw-animate-css": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nocobase/nocobase.git",
    "directory": "packages/plugins/app-plugin-modules"
  }
}
