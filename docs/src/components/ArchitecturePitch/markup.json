\"></rect><text x=\"494\" y=\"255\" font-size=\"12\" font-weight=\"600\" fill=\"#1f2433\">数据库</text><text x=\"536\" y=\"255\" font-size=\"11.5\" fill=\"#5d6575\" class=\"mono\">@nocobase/database</text><rect x=\"700\" y=\"240\" width=\"248\" height=\"22\" rx=\"4\" fill=\"#f4f6fb\" stroke=\"#dde2ec\"></rect><text x=\"708\" y=\"255\" font-size=\"12\" font-weight=\"600\" fill=\"#1f2433\">资源路由</text><text x=\"762\" y=\"255\" font-size=\"11.5\" fill=\"#5d6575\" class=\"mono\">@nocobase/resourcer</text><rect x=\"272\" y=\"268\" width=\"208\" height=\"22\" rx=\"4\" fill=\"#f4f6fb\" stroke=\"#dde2ec\"></rect><text x=\"280\" y=\"283\" font-size=\"12\" font-weight=\"600\" fill=\"#1f2433\">权限</text><text x=\"310\" y=\"283\" font-size=\"11.5\" fill=\"#5d6575\" class=\"mono\">@nocobase/acl</text><rect x=\"486\" y=\"268\" width=\"208\" height=\"22\" rx=\"4\" fill=\"#f4f6fb\" stroke=\"#dde2ec\"></rect><text x=\"494\" y=\"283\" font-size=\"12\" font-weight=\"600\" fill=\"#1f2433\">认证</text><text x=\"524\" y=\"283\" font-size=\"11.5\" fill=\"#5d6575\" class=\"mono\">@nocobase/auth</text><rect x=\"700\" y=\"268\" width=\"208\" height=\"22\" rx=\"4\" fill=\"#f4f6fb\" stroke=\"#dde2ec\"></rect><text x=\"708\" y=\"283\" font-size=\"12\" font-weight=\"600\" fill=\"#1f2433\">缓存</text><text x=\"738\" y=\"283\" font-size=\"11.5\" fill=\"#5d6575\" class=\"mono\">@nocobase/cache</text><rect x=\"914\" y=\"268\" width=\"34\" height=\"22\" rx=\"4\" fill=\"#f4f6fb\" stroke=\"#dde2ec\"></rect><text x=\"922\" y=\"283\" font-size=\"11.5\" fill=\"#3b4560\" class=\"mono\">…</text><rect x=\"260\" y=\"312\" width=\"700\" height=\"98\" rx=\"7\" fill=\"#ffffff\" stroke=\"#9db0ee\" stroke-width=\"1\"></rect><text x=\"272\" y=\"335\" font-size=\"14\" font-weight=\"600\" fill=\"#1f2433\">插件 · 运行时启用、停用</text><rect x=\"272\" y=\"348\" width=\"208\" height=\"22\" rx=\"4\" fill=\"#f4f6fb\" stroke=\"#dde2ec\"></rect><text x=\"280\" y=\"363\" font-size=\"12\" font-weight=\"600\" fill=\"#1f2433\">权限</text><text x=\"310\" y=\"363\" font-size=\"11.5\" fill=\"#5d6575\" class=\"mono\">plugin-acl</text><rect x=\"486\" y=\"348\" width=\"208\" height=\"22\" rx=\"4\" fill=\"#f4f6fb\" stroke=\"#dde2ec\"></rect><text x=\"494\" y=\"363\" font-size=\"12\" font-weight=\"600\" fill=\"#1f2433\">认证</text><text x=\"524\" y=\"363\" font-size=\"11.5\" fill=\"#5d6575\" class=\"mono\">plugin-auth</text><rect x=\"700\" y=\"348\" width=\"248\" height=\"22\" rx=\"4\" fill=\"#f4f6fb\" stroke=\"#dde2ec\"></rect><text x=\"708\" y=\"363\" font-size=\"12\" font-weight=\"600\" fill=\"#1f2433\">用户</text><text x=\"738\" y=\"363\" font-size=\"11.5\" fill=\"#5d6575\" class=\"mono\">plugin-users</text><rect x=\"272\" y=\"376\" width=\"208\" height=\"22\" rx=\"4\" fill=\"#f4f6fb\" stroke=\"#dde2ec\"></rect><text x=\"280\" y=\"391\" font-size=\"12\" font-weight=\"600\" fill=\"#1f2433\">工作流</text><text x=\"322\" y=\"391\" font-size=\"11.5\" fill=\"#5d6575\" class=\"mono\">plugin-workflow</text><rect x=\"486\" y=\"376\" width=\"208\" height=\"22\" rx=\"4\" fill=\"#f4f6fb\" stroke=\"#dde2ec\"></rect><text x=\"494\" y=\"391\" font-size=\"12\" font-weight=\"600\" fill=\"#1f2433\">界面布局</text><text x=\"548\" y=\"391\" font-size=\"11.5\" fill=\"#5d6575\" class=\"mono\">plugin-ui-layout</text><rect x=\"700\" y=\"376\" width=\"208\" height=\"22\" rx=\"4\" fill=\"#f4f6fb\" stroke=\"#dde2ec\"></rect><text x=\"708\" y=\"391\" font-size=\"12\" font-weight=\"600\" fill=\"#1f2433\">文件</text><text x=\"738\" y=\"391\" font-size=\"11.5\" fill=\"#5d6575\" class=\"mono\">plugin-file-manager</text><rect x=\"914\" y=\"376\" width=\"34\" height=\"22\" rx=\"4\" fill=\"#f4f6fb\" stroke=\"#dde2ec\"></rect><text x=\"922\" y=\"391\" font-size=\"11.5\" fill=\"#3b4560\" class=\"mono\">…</text><rect x=\"240\" y=\"466\" width=\"740\" height=\"116\" rx=\"10\" fill=\"#fbfcfd\" stroke=\"#c9d0da\" stroke-width=\"1\" stroke-dasharray=\"5 4\"></rect><text x=\"254\" y=\"487\" font-size=\"13\" font-weight=\"600\" fill=\"#3f4757\">数据库</text><path d=\"M260,507 a150,7 0 0,0 300,0 v50 a150,7 0 0,1 -300,0 z\" fill=\"#ffffff\" stroke=\"#b3bbc8\" stroke-width=\"1\"></path><ellipse cx=\"410\" cy=\"507\" rx=\"150\" ry=\"7\" fill=\"#ffffff\" stroke=\"#b3bbc8\" stroke-width=\"1\"></ellipse><text x=\"274\" y=\"533\" font-size=\"14\" font-weight=\"600\" fill=\"#1f2433\">业务数据</text><text x=\"274\" y=\"551\" font-size=\"12\" fill=\"#5d6575\">客户、订单、工单…</text><path d=\"M580,507 a190,7 0 0,0 380,0 v50 a190,7 0 0,1 -380,0 z\" fill=\"#fdf4ea\" stroke=\"#d9a066\" stroke-width=\"1\"></path><ellipse cx=\"770\" cy=\"507\" rx=\"190\" ry=\"7\" fill=\"#fdf4ea\" stroke=\"#d9a066\" stroke-width=\"1\"></ellipse><text x=\"594\" y=\"533\" font-size=\"14\" font-weight=\"600\" fill=\"#4f2e0d\">配置数据</text><text x=\"594\" y=\"551\" font-size=\"12\" fill=\"#86592b\">表结构 · 页面与路由 · 权限 · 工作流</text><path d=\"M180,80 L240,80\" fill=\"none\" stroke=\"#7a8291\" stroke-width=\"1.2\" marker-end=\"url(#d1-a)\"></path><text x=\"210\" y=\"72\" font-size=\"12\" fill=\"#4a5160\" text-anchor=\"middle\" stroke=\"#ffffff\" stroke-width=\"4\" paint-order=\"stroke\" stroke-linejoin=\"round\">界面配置</text><path d=\"M180,240 L240,240\" fill=\"none\" stroke=\"#7a8291\" stroke-width=\"1.2\" marker-end=\"url(#d1-a)\"></path><text x=\"210\" y=\"232\" font-size=\"12\" fill=\"#4a5160\" text-anchor=\"middle\" stroke=\"#ffffff\" stroke-width=\"4\" paint-order=\"stroke\" stroke-linejoin=\"round\">nb api</text><path d=\"M610,130 L610,166\" fill=\"none\" stroke=\"#7a8291\" stroke-width=\"1.2\" marker-end=\"url(#d1-a)\"></path><text x=\"620\" y=\"152\" font-size=\"12\" fill=\"#4a5160\" text-anchor=\"start\" stroke=\"#ffffff\" stroke-width=\"4\" paint-order=\"stroke\" stroke-linejoin=\"round\">/api</text><path d=\"M610,430 L610,466\" fill=\"none\" stroke=\"#7a8291\" stroke-width=\"1.2\" marker-end=\"url(#d1-a)\"></path><text x=\"620\" y=\"452\" font-size=\"12\" fill=\"#4a5160\" text-anchor=\"start\" stroke=\"#ffffff\" stroke-width=\"4\" paint-order=\"stroke\" stroke-linejoin=\"round\">读写</text></svg></div>\n      <ul class=\"fit\">\n        <li><b><i class=\"st no\"></i>分模块上线</b>所有模块的配置在同一个库里，发布时很难只带走其中一个。</li>\n        <li><b><i class=\"st no\"></i>工作流与权限</b>配置难度大、不够灵活，复杂需求难以满足；改动也不能像代码一样评审。</li>\n        <li><b><i class=\"st no\"></i>AI 搭建受限</b>AI 只能调用配置接口，平台没有提供的能力就做不出来。</li>\n      </ul>\n    </div>\n  </section>\n\n  <!-- 02 -->\n  <section class=\"sec\" id=\"s2\">\n    <p class=\"label\">02</p>\n    <h2>NocoBase 2 AI Portal <span class=\"m\">· 前端可以自定义</span></h2>\n    <p class=\"lead\">AI Portal 是一个由 AI 编写的前端工程，界面不再受平台组件限制，可以按业务完全自定义；登录、权限、数据接口仍由 NocoBase 2 提供。</p>\n    <div class=\"sec-body\">\n      <div class=\"canvas\"><svg id=\"d2\" role=\"img\" aria-label=\"NocoBase 2 AI Portal 架构\" viewBox=\"0 0 1000 520\"><defs><marker id=\"d2-a\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"7\" markerHeight=\"7\" orient=\"auto-start-reverse\"><path d=\"M0,0 L10,5 L0,10 z\" fill=\"#7a8291\"></path></marker></defs><rect x=\"20\" y=\"30\" width=\"180\" height=\"54\" rx=\"7\" fill=\"#ffffff\" stroke=\"#6b7383\" stroke-width=\"1\"></rect><circle cx=\"40\" cy=\"51\" r=\"5.5\" fill=\"none\" stroke=\"#5d6575\" stroke-width=\"1.3\"></circle><path d=\"M30,69 q10,-14 20,0\" fill=\"none\" stroke=\"#5d6575\" stroke-width=\"1.3\"></path><text x=\"58\" y=\"54\" font-size=\"13.5\" font-weight=\"600\" fill=\"#1f2433\">人</text><text x=\"58\" y=\"72\" font-size=\"12\" fill=\"#5d6575\">配置无代码 Portal</text><rect x=\"20\" y=\"104\" width=\"180\" height=\"54\" rx=\"7\" fill=\"#ffffff\" stroke=\"#6b7383\" stroke-width=\"1\"></rect><circle cx=\"40\" cy=\"125\" r=\"5.5\" fill=\"none\" stroke=\"#5d6575\" stroke-width=\"1.3\"></circle><path d=\"M30,143 q10,-14 20,0\" fill=\"none\" stroke=\"#5d6575\" stroke-width=\"1.3\"></path><text x=\"58\" y=\"128\" font-size=\"13.5\" font-weight=\"600\" fill=\"#1f2433\">AI Agent</text><text x=\"58\" y=\"146\" font-size=\"12\" fill=\"#5d6575\">写 AI Portal 前端</text><rect x=\"20\" y=\"190\" width=\"180\" height=\"270\" rx=\"10\" 