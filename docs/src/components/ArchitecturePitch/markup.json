=\"860\" cy=\"425\" rx=\"100\" ry=\"7\" fill=\"#fdf4ea\" stroke=\"#d9a066\" stroke-width=\"1\"></ellipse><text x=\"774\" y=\"451\" font-size=\"14\" font-weight=\"600\" fill=\"#4f2e0d\">Portal 登记</text><text x=\"774\" y=\"469\" font-size=\"12\" fill=\"#86592b\">multiPortals</text><rect x=\"930\" y=\"413\" width=\"32\" height=\"17\" rx=\"8.5\" fill=\"#fff4e5\" stroke=\"#e39a35\"></rect><text x=\"946\" y=\"425.5\" font-size=\"10.5\" font-weight=\"600\" fill=\"#8a5300\" text-anchor=\"middle\">新增</text><path d=\"M620,348 L620,388\" fill=\"none\" stroke=\"#7a8291\" stroke-width=\"1.2\" marker-end=\"url(#d2-a)\"></path><text x=\"630\" y=\"372\" font-size=\"12\" fill=\"#4a5160\" text-anchor=\"start\" stroke=\"#ffffff\" stroke-width=\"4\" paint-order=\"stroke\" stroke-linejoin=\"round\">读写</text></svg></div>\n      <ul class=\"fit\">\n        <li><b><i class=\"st ok\"></i>前端可以自定义</b>AI 直接写 React 源码，页面和交互按业务需要来做，不受平台组件限制。</li>\n        <li><b><i class=\"st part\"></i>独立开发与部署</b>前端可以各自开发、各自部署；后端配置仍然共用。</li>\n        <li><b><i class=\"st part\"></i>工作流与权限</b>仍是 NocoBase 2 的配置，问题没有解决。</li>\n      </ul>\n    </div>\n  </section>\n\n  <!-- 03 -->\n  <section class=\"sec\" id=\"s3\">\n    <p class=\"label\">03</p>\n    <h2>NocoBase 3</h2>\n    <div class=\"sub first\">\n      <h3>NocoBase 3 Core <span class=\"m\">· 整个应用都是源码</span></h3>\n      <p class=\"lead\">页面、接口、表结构、权限、工作流都在你的仓库里，由 AI 编写；NocoBase 以 npm 包的形式提供框架、通用能力和基础库。</p>\n    </div>\n    <div class=\"sec-body\">\n      <div class=\"canvas\"><svg id=\"d3\" role=\"img\" aria-label=\"NocoBase 3 应用架构\" viewBox=\"0 0 1000 730\"><defs><marker id=\"d3-a\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"7\" markerHeight=\"7\" orient=\"auto-start-reverse\"><path d=\"M0,0 L10,5 L0,10 z\" fill=\"#7a8291\"></path></marker></defs><rect x=\"20\" y=\"50\" width=\"170\" height=\"60\" rx=\"7\" fill=\"#ffffff\" stroke=\"#6b7383\" stroke-width=\"1\"></rect><circle cx=\"40\" cy=\"74\" r=\"5.5\" fill=\"none\" stroke=\"#5d6575\" stroke