---
/** The NocoBase 2 vs 3 comparison: static markup (`markup*.json`) with a section indicator that follows scrolling. */
import image0 from './assets/image-0.png';
import image1 from './assets/image-1.jpeg';
import image2 from './assets/image-2.jpeg';
import image3 from './assets/image-3.jpeg';
import image4 from './assets/image-4.jpeg';
import { pickLanguage } from '../../../shared/languages.ts';
import cnMarkup from './markup.json';
import enMarkup from './markup.en.json';
import viMarkup from './markup.vi.json';
import '../../styles/legacy-typography.css';
import './index.scss';

interface Props {
  language: string;
}

const images = [image0, image1, image2, image3, image4];
const source = pickLanguage(
  { cn: cnMarkup, en: enMarkup, vi: viMarkup },
  Astro.props.language,
);
const markup = images.reduce(
  (html, image, index) =>
    html.replaceAll(
      `/architecture-pitch/image-${index}.${index === 0 ? 'png' : 'jpeg'}`,
      image.src,
    ),
  source,
);
---

<div class='architecture-pitch' data-pagefind-body set:html={markup} />

<script>
  const container = document.querySelector<HTMLElement>('.architecture-pitch');
  if (container) {
    const links = container.querySelectorAll<HTMLAnchorElement>('[data-step]');
    const strip = container.querySelector<HTMLOListElement>('.nav ol');
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          links.forEach((link) => {
            const active = link.dataset.step === entry.target.id;
            link.classList.toggle('active', active);
            const item = link.parentElement;
            if (!active || !strip || !item) return;
            if (item.offsetLeft < strip.scrollLeft)
              strip.scrollLeft = item.offsetLeft;
            else if (
              item.offsetLeft + item.offsetWidth >
              strip.scrollLeft + strip.clientWidth
            )
              strip.scrollLeft =
                item.offsetLeft + item.offsetWidth - strip.clientWidth;
          });
        }
      },
      { rootMargin: '-40% 0px -55% 0px' },
    );
    container
      .querySelectorAll('section.sec')
      .forEach((section) => observer.observe(section));
  }
</script>
