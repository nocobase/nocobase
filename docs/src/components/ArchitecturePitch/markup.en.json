 x=\"738\" y=\"363\" font-size=\"11.5\" fill=\"#5d6575\" class=\"mono\">plugin-users</text><rect x=\"272\" y=\"376\" width=\"208\" height=\"22\" rx=\"4\" fill=\"#f4f6fb\" stroke=\"#dde2ec\"></rect><text x=\"280\" y=\"391\" font-size=\"12\" font-weight=\"600\" fill=\"#1f2433\" textLength=\"36\" lengthAdjust=\"spacingAndGlyphs\">Workflow</text><text x=\"322\" y=\"391\" font-size=\"11.5\" fill=\"#5d6575\" class=\"mono\">plugin-workflow</text><rect x=\"486\" y=\"376\" width=\"208\" height=\"22\" rx=\"4\" fill=\"#f4f6fb\" stroke=\"#dde2ec\"></rect><text x=\"494\" y=\"391\" font-size=\"12\" font-weight=\"600\" fill=\"#1f2433\" textLength=\"48\" lengthAdjust=\"spacingAndGlyphs\">UI layout</text><text x=\"548\" y=\"391\" font-size=\"11.5\" fill=\"#5d6575\" class=\"mono\">plugin-ui-layout</text><rect x=\"700\" y=\"376\" width=\"208\" height=\"22\" rx=\"4\" fill=\"#f4f6fb\" stroke=\"#dde2ec\"></rect><text x=\"708\" y=\"391\" font-size=\"12\" font-weight=\"600\" fill=\"#1f2433\" textLength=\"24\" lengthAdjust=\"spacingAndGlyphs\">Files</text><text x=\"738\" y=\"391\" font-size=\"11.5\" fill=\"#5d6575\" class=\"mono\">plugin-file-manager</text><rect x=\"914\" y=\"376\" width=\"34\" height=\"22\" rx=\"4\" fill=\"#f4f6fb\" stroke=\"#dde2ec\"></rect><text x=\"922\" y=\"391\" font-size=\"11.5\" fill=\"#3b4560\" class=\"mono\">…</text><rect x=\"240\" y=\"466\" width=\"740\" height=\"116\" rx=\"10\" fill=\"#fbfcfd\" stroke=\"#c9d0da\" stroke-width=\"1\" stroke-dasharray=\"5 4\"></rect><text x=\"254\" y=\"487\" font-size=\"13\" font-weight=\"600\" fill=\"#3f4757\" textLength=\"39\" lengthAdjust=\"spacingAndGlyphs\">Database</text><path d=\"M260,507 a150,7 0 0,0 300,0 v50 a150,7 0 0,1 -300,0 z\" fill=\"#ffffff\" stroke=\"#b3bbc8\" stroke-width=\"1\"></path><ellipse cx=\"410\" cy=\"507\" rx=\"150\" ry=\"7\" fill=\"#ffffff\" stroke=\"#b3bbc8\" stroke-width=\"1\"></ellipse><text x=\"274\" y=\"533\" font-size=\"14\" font-weight=\"600\" fill=\"#1f2433\" textLength=\"56\" lengthAdjust=\"spacingAndGlyphs\">Business data</text><text x=\"274\" y=\"551\" font-size=\"12\" fill=\"#5d6575\" textLength=\"92\" lengthAdjust=\"spacingAndGlyphs\">Customers, orders, tickets…</text><path d=\"M580,507 a190,7 0 0,0 380,0 v50 a190,7 0 0,1 -380,0 z\" fill=\"#fdf4ea\" stroke=\"#d9a066\" stroke-width=\"1\"></path><ellipse cx=\"770\" cy=\"507\" rx=\"190\" ry=\"7\" fill=\"#fdf4ea\" stroke=\"#d9a066\" stroke-width=\"1\"></ellipse><text x=\"594\" y=\"533\" font-size=\"14\" font-weight=\"600\" fill=\"#4f2e0d\" textLength=\"56\" lengthAdjust=\"spacingAndGlyphs\">Configuration</text><text x=\"594\" y=\"551\" font-size=\"12\" fill=\"#86592b\" textLength=\"216\" lengthAdjust=\"spacingAndGlyphs\">Schema · Pages · Permissions · Workflow</text><path d=\"M180,80 L240,80\" fill=\"none\" stroke=\"#7a8291\" stroke-width=\"1.2\" marker-end=\"url(#d1-a)\"></path><text x=\"210\" y=\"72\" font-size=\"12\" fill=\"#4a5160\" text-anchor=\"middle\" stroke=\"#ffffff\" stroke-width=\"4\" paint-order=\"stroke\" stroke-linejoin=\"round\" textLength=\"48\" lengthAdjust=\"spacingAndGlyphs\">UI config</text><path d=\"M180,240 L240,240\" fill=\"none\" stroke=\"#7a8291\" stroke-width=\"1.2\" marker-end=\"url(#d1-a)\"></path><text x=\"210\" y=\"232\" font-size=\"12\" fill=\"#4a5160\" text-anchor=\"middle\" stroke=\"#ffffff\" stroke-width=\"4\" paint-order=\"stroke\" stroke-linejoin=\"round\">nb api</text><path d=\"M610,130 L610,166\" fill=\"none\" stroke=\"#7a8291\" stroke-width=\"1.2\" marker-end=\"url(#d1-a)\"></path><text x=\"620\" y=\"152\" font-size=\"12\" fill=\"#4a5160\" text-anchor=\"start\" stroke=\"#ffffff\" stroke-width=\"4\" paint-order=\"stroke\" stroke-linejoin=\"round\">/api</text><path d=\"M610,430 L610,466\" fill=\"none\" stroke=\"#7a8291\" stroke-width=\"1.2\" marker-end=\"url(#d1-a)\"></path><text x=\"620\" y=\"452\" font-size=\"12\" fill=\"#4a5160\" text-anchor=\"start\" stroke=\"#ffffff\" stroke-width=\"4\" paint-order=\"stroke\" stroke-linejoin=\"round\" textLength=\"24\" lengthAdjust=\"spacingAndGlyphs\">Read/write</text></svg></div>\n      <ul class=\"fit\">\n        <li><b><i class=\"st no\"></i>Release individual modules</b>All modules share configuration in one database, making it difficult to release just one of them.</li>\n        <li><b><i class=\"st no\"></i>Workflows and permissions</b>Configuration is difficult and inflexible for complex requirements; changes cannot be reviewed like code.</li>\n        <li><b><i class=\"st no\"></i>Limited AI development</b>AI can only call configuration APIs and cannot build capabilities the platform does not provide.</li>\n      </ul>\n    </div>\n  </section>\n\n  <!-- 02 -->\n  <section class=\"sec\" id=\"s2\">\n    <p class=\"label\">02</p>\n    <h2>NocoBase 2 AI Portal <span class=\"m\">· A customizable frontend</span></h2>\n    <p class=\"lead\">AI Portal is a frontend project written by AI. Its interface can be fully customized for your business without being limited to platform components; NocoBase 2 still provides sign-in, permissions, and data APIs.</p>\n    <div class=\"sec-body\">\n      <div class=\"canvas\"><svg id=\"d2\" role=\"img\" aria-label=\"NocoBase 2 AI Portal architecture\" viewBox=\"0 0 1000 520\"><defs><marker id=\"d2-a\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"7\" markerHeight=\"7\" orient=\"auto-start-reverse\"><path d=\"M0,0 L10,5 L0,10 z\" fill=\"#7a8291\"></path></marker></defs><rect x=\"20\" y=\"30\" width=\"180\" height=\"54\" rx=\"7\" fill=\"#ffffff\" stroke=\"#6b7383\" stroke-width=\"1\"></rect><circle cx=\"40\" cy=\"51\" r=\"5.5\" fill=\"none\" stroke=\"#5d6575\" stroke-width=\"1.3\"></circle><path d=\"M30,69 q10,-14 20,0\" fill=\"none\" stroke=\"#5d6575\" stroke-width=\"1.3\"></path><text x=\"58\" y=\"54\" font-size=\"13.5\" font-weight=\"600\" fill=\"#1f2433\" textLength=\"14\" lengthAdjust=\"spacingAndGlyphs\">User</text><text x=\"58\" y=\"72\" font-size=\"12\" fill=\"#5d6575\" textLength=\"107\" lengthAdjust=\"spacingAndGlyphs\">Configure no-code Portal</text><rect x=\"20\" y=\"104\" width=\"180\" height=\"54\" rx=\"7\" fill=\"#ffffff\" stroke=\"#6b7383\" stroke-width=\"1\"></rect><circle cx=\"40\" cy=\"125\" r=\"5.5\" fill=\"none\" stroke=\"#5d6575\" stroke-width=\"1.3\"></circle><path d=\"M30,143 q10,-14 20,0\" fill=\"none\" stroke=\"#5d6575\" stroke-width=\"1.3\"></path><text x=\"58\" y=\"128\" font-size=\"13.5\" font-weight=\"600\" fill=\"#1f2433\">AI Agent</text><text x=\"58\" y=\"146\" font-size=\"12\" fill=\"#5d6575\" textLength=\"110\" lengthAdjust=\"spacingAndGlyphs\">Build AI Portal frontend</text><rect x=\"20\" y=\"190\" width=\"180\" height=\"270\" rx=\"10\" fill=\"#fcfaff\" stroke=\"#c4b0ec\" stroke-width=\"1\" stroke-dasharray=\"5 4\"></rect><text x=\"34\" y=\"211\" font-size=\"13\" font-weight=\"600\" fill=\"#5b34ad\" textLength=\"99\" lengthAdjust=\"spacingAndGlyphs\">AI Portal source</text><rect x=\"36\" y=\"224\" width=\"148\" height=\"52\" rx=\"7\" fill=\"#ffffff\" stroke=\"#b9a2e8\" stroke-width=\"1\"></rect><text x=\"48\" y=\"247\" font-size=\"13.5\" font-weight=\"600\" fill=\"#1f2433\" textLength=\"54\" lengthAdjust=\"spacingAndGlyphs\">Local development</text><text x=\"48\" y=\"265\" font-size=\"12\" fill=\"#5d6575\">nb portal dev</text><rect x=\"154\" y=\"215\" width=\"32\" height=\"17\" rx=\"8.5\" fill=\"#fff4e5\" stroke=\"#e39a35\"></rect><text x=\"170\" y=\"227.5\" font-size=\"10.5\" font-weight=\"600\" fill=\"#8a5300\" text-anchor=\"middle\">New</text><rect x=\"36\" y=\"310\" width=\"148\" height=\"52\" rx=\"7\" fill=\"#ffffff\" stroke=\"#b9a2e8\" stroke-width=\"1\"></rect><text x=\"48\" y=\"333\" font-size=\"13.5\" font-weight=\"600\" fill=\"#1f2433\" textLength=\"54\" lengthAdjust=\"spacingAndGlyphs\">Source storage</text><text x=\"48\" y=\"351\" font-size=\"12\" fill=\"#5d6575\">NocoBase or Git</text><rect x=\"154\" y=\"301\" width=\"32\" height=\"17\" rx=\"8.5\" fill=\"#fff4e5\" stroke=\"#e39a35\"></rect><text x=\"170\" y=\"313.5\" font-size=\"10.5\" font-weight=\"600\" fi