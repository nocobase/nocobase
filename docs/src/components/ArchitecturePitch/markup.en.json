idth=\"340\" height=\"60\" rx=\"7\" fill=\"#eef2fd\" stroke=\"#6f88e3\" stroke-width=\"1\"></rect><text x=\"272\" y=\"663\" font-size=\"13.5\" font-weight=\"600\" fill=\"#1f2a5c\" textLength=\"54\" lengthAdjust=\"spacingAndGlyphs\">App process</text><text x=\"272\" y=\"681\" font-size=\"12\" fill=\"#4d5884\" textLength=\"162\" lengthAdjust=\"spacingAndGlyphs\">Hono server + frontend build</text><path d=\"M620,641 a170,7 0 0,0 340,0 v48 a170,7 0 0,1 -340,0 z\" fill=\"#ffffff\" stroke=\"#b3bbc8\" stroke-width=\"1\"></path><ellipse cx=\"790\" cy=\"641\" rx=\"170\" ry=\"7\" fill=\"#ffffff\" stroke=\"#b3bbc8\" stroke-width=\"1\"></ellipse><text x=\"634\" y=\"667\" font-size=\"14\" font-weight=\"600\" fill=\"#1f2433\" textLength=\"42\" lengthAdjust=\"spacingAndGlyphs\">Database</text><text x=\"634\" y=\"685\" font-size=\"12\" fill=\"#5d6575\" textLength=\"151\" lengthAdjust=\"spacingAndGlyphs\">Business data only; no UI configuration</text><path d=\"M610,556 L610,600\" fill=\"none\" stroke=\"#7a8291\" stroke-width=\"1.2\" marker-end=\"url(#d3-a)\"></path><text x=\"620\" y=\"582\" font-size=\"12\" fill=\"#4a5160\" text-anchor=\"start\" stroke=\"#ffffff\" stroke-width=\"4\" paint-order=\"stroke\" stroke-linejoin=\"round\">pnpm build --tar → app-installer</text></svg></div>\n      <ul class=\"fit\">\n        <li><b><i class=\"st ok\"></i>Develop independently, release by module</b>Modules are developed in parallel on branches. Release what you merge; unfinished work stays separate.</li>\n        <li><b><i class=\"st ok\"></i>Workflows and permissions</b>Code can express complex rules, with configuration interfaces added when business users need to make adjustments. Every change can be reviewed and reverted.</li>\n        <li><b><i class=\"st ok\"></i>Multiple applications, shared data</b>One application maintains the master data. Others connect to its database as an external data source, with read-only or read/write access as needed and permissions enforced on the server.</li>\n      </ul>\n      <a class=\"lib\" href=\"https://ui.nocobase.com\" target=\"_blank\" rel=\"noopener\">\n        <span><b>UI Library · Business components</b>Sign-in, approvals, permission editors, inboxes, boards, diagrams, rich text, and more. Copy source into your project with one command, then customize it freely. More components are being added.</span>\n        <span class=\"go\">ui.nocobase.com →</span>\n      </a>\n    </div>\n\n    <div class=\"sub\">\n      <h3>NocoBase 3 Solutions <span class=\"m\">· Business applications built on Core</span> <span class=\"wip soon\">Coming soon</span></h3>\n      <p class=\"lead\">Complete business application source, ready to use or further customized by AI for your own system.</p>\n      <div class=\"sec-body\">\n        <div class=\"sols\">\n          <figure class=\"sol\">\n            <img src=\"/architecture-pitch/image-1.jpeg\" alt=\"NocoCRM overview\" loading=\"lazy\">\n            <figcaption><b>NocoCRM</b>Leads, opportunities, companies, contacts, and approvals; built-in sales AI assistants and Agents automate follow-ups and draft emails.</figcaption>\n          </figure>\n          <figure class=\"sol\">\n            <img src=\"/architecture-pitch/image-2.jpeg\" alt=\"ERP operations overview\" loading=\"lazy\">\n            <figcaption><b>ERP</b>Weighbridge operations, daily production reports, inventory, sales orders, and disposal contracts, with a clear view across multiple sites.</figcaption>\n          </figure>\n          <figure class=\"sol\">\n            <img src=\"/architecture-pitch/image-3.jpeg\" alt=\"NocoReach insights\" loading=\"lazy\">\n            <figcaption><b>NocoReach</b>Combines search, traffic, community, and GitHub data. AI identifies growth opportunities daily, and Agents implement changes in the repository and open PRs.</figcaption>\n          </figure>\n        </div>\n        <p class=\"more\">More solutions are being added.</p>\n      </div>\n    </div>\n\n    <div class=\"sub\">\n      <h3>NocoBase 3 Studio <span class=\"m\">· Continuous development, testing, integration, and deployment across applications</span> <span class=\"wip\">In development</span></h3>\n      <p class=\"lead\">Studio manages multiple applications, each with its own repository and environments, moving through development, testing, integration, and deployment at its own pace. Agents write code on runners hosted on team servers or development computers; people step in for decisions, acceptance, and releases.</p>\n      <div class=\"sec-body\">\n        <div class=\"canvas\"><svg id=\"d4\" role=\"img\" aria-label=\"NocoBase Studio: continuous delivery across applications\" viewBox=\"0 0 1000 534\"><defs><marker id=\"d4-a\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"7\" markerHeight=\"7\" orient=\"auto-start-reverse\"><path d=\"M0,0 L10,5 L0,10 z\" fill=\"#7a8291\"></path></marker></defs><g><rect x=\"20\" y=\"20\" width=\"280\" height=\"152\" rx=\"10\" fill=\"#fbfcfd\" stroke=\"#c9d0da\" stroke-width=\"1\" stroke-dasharray=\"5 4\"></rect><text x=\"34\" y=\"41\" font-size=\"13\" font-weight=\"600\" fill=\"#3f4757\" textLength=\"39\" lengthAdjust=\"spacingAndGlyphs\">Runner</text><text x=\"83\" y=\"41\" font-size=\"11.5\" fill=\"#3f4757\" class=\"mono\" opacity=\"0.8\" textLength=\"123\" lengthAdjust=\"spacingAndGlyphs\">Team server · Developer computer</text></g><rect x=\"36\" y=\"56\" width=\"248\" height=\"98\" rx=\"7\" fill=\"#ffffff\" stroke=\"#9db0ee\" stroke-width=\"1\"></rect><text x=\"48\" y=\"79\" font-size=\"14\" font-weight=\"600\" fill=\"#1f2433\" textLength=\"75\" lengthAdjust=\"spacingAndGlyphs\">Coding Agent</text><rect x=\"48\" y=\"92\" width=\"109\" height=\"22\" rx=\"4\" fill=\"#f4f6fb\" stroke=\"#dde2ec\"></rect><text x=\"56\" y=\"107\" font-size=\"11.5\" fill=\"#3b4560\" class=\"mono\">Claude Code</text><rect x=\"163\" y=\"92\" width=\"109\" height=\"22\" rx=\"4\" fill=\"#f4f6fb\" stroke=\"#dde2ec\"></rect><text x=\"171\" y=\"107\" fon