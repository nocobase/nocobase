ircle><path d=\"M860,100 q10,-14 20,0\" fill=\"none\" stroke=\"#5d6575\" stroke-width=\"1.3\"></path><text x=\"888\" y=\"85\" font-size=\"13.5\" font-weight=\"600\" fill=\"#1f2433\" textLength=\"14\" lengthAdjust=\"spacingAndGlyphs\">User</text><text x=\"888\" y=\"103\" font-size=\"12\" fill=\"#5d6575\" textLength=\"68\" lengthAdjust=\"spacingAndGlyphs\">Decide · Accept</text><path d=\"M340,90 L300,90\" fill=\"none\" stroke=\"#7a8291\" stroke-width=\"1.2\" marker-end=\"url(#d4-a)\"></path><text x=\"320\" y=\"82\" font-size=\"12\" fill=\"#4a5160\" text-anchor=\"middle\" stroke=\"#ffffff\" stroke-width=\"4\" paint-order=\"stroke\" stroke-linejoin=\"round\" textLength=\"24\" lengthAdjust=\"spacingAndGlyphs\">Assign</text><path d=\"M810,88 L850,88\" fill=\"none\" stroke=\"#7a8291\" stroke-width=\"1.2\" marker-end=\"url(#d4-a)\" marker-start=\"url(#d4-a)\"></path><text x=\"830\" y=\"80\" font-size=\"12\" fill=\"#4a5160\" text-anchor=\"middle\" stroke=\"#ffffff\" stroke-width=\"4\" paint-order=\"stroke\" stroke-linejoin=\"round\" textLength=\"24\" lengthAdjust=\"spacingAndGlyphs\">Approval</text><path d=\"M160,172 L160,212\" fill=\"none\" stroke=\"#7a8291\" stroke-width=\"1.2\" marker-end=\"url(#d4-a)\"></path><text x=\"170\" y=\"197\" font-size=\"12\" fill=\"#4a5160\" text-anchor=\"start\" stroke=\"#ffffff\" stroke-width=\"4\" paint-order=\"stroke\" stroke-linejoin=\"round\" textLength=\"75\" lengthAdjust=\"spacingAndGlyphs\">Push branch, open PR</text><path d=\"M575,172 L575,212\" fill=\"none\" stroke=\"#7a8291\" stroke-width=\"1.2\" marker-end=\"url(#d4-a)\"></path><text x=\"585\" y=\"197\" font-size=\"12\" fill=\"#4a5160\" text-anchor=\"start\" stroke=\"#ffffff\" stroke-width=\"4\" paint-order=\"stroke\" stroke-linejoin=\"round\" textLength=\"85\" lengthAdjust=\"spacingAndGlyphs\">Check, merge, release</text><g><rect x=\"20\" y=\"212\" width=\"960\" height=\"310\" rx=\"10\" fill=\"#fbfcfd\" stroke=\"#c9d0da\" stroke-width=\"1\" stroke-dasharray=\"5 4\"></rect><text x=