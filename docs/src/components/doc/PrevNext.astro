---
import { uiText } from '../../lib/ui-text.ts';

interface Props {
  language: string;
  prev?: { text: string; href: string };
  next?: { text: string; href: string };
}

const { language, prev, next } = Astro.props;
const text = uiText(language);
---

{(prev || next) && (
  <nav class='prev-next' aria-label={text.pagination} data-pagefind-ignore>
    {prev ? (
      <a
        class='prev-next__item prev-next__item--prev'
        href={prev.href}
        rel='prev'
      >
        <span class='prev-next__label'>{text.previousPage}</span>
        <span class='prev-next__title'>
          <svg viewBox='0 0 24 24' width='16' height='16' aria-hidden='true'>
            <path
              fill='none'
              stroke='currentColor'
              stroke-width='1.5'
              d='m15 6-6 6 6 6'
            />
          </svg>
          {prev.text}
        </span>
      </a>
    ) : (
      <span />
    )}
    {next && (
      <a
        class='prev-next__item prev-next__item--next'
        href={next.href}
        rel='next'
      >
        <span class='prev-next__label'>{text.nextPage}</span>
        <span class='prev-next__title'>
          {next.text}
          <svg viewBox='0 0 24 24' width='16' height='16' aria-hidden='true'>
            <path
              fill='none'
              stroke='currentColor'
              stroke-width='1.5'
              d='m9 6 6 6-6 6'
            />
          </svg>
        </span>
      </a>
    )}
  </nav>
)}
