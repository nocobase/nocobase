---
/** The deployment guide of each language, with a Markdown twin for search and llms outputs. */
import type { GetStaticPaths } from 'astro';
import { localizePath } from '../../../shared/languages.ts';
import Deployment from '../../components/Deployment/index.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  getPages,
  staticPathsOf,
  translationsOf,
  type DocPage,
} from '../../lib/pages.ts';

export const getStaticPaths = (() =>
  staticPathsOf('deployment')) satisfies GetStaticPaths;

interface Props {
  page: DocPage;
}

const { page } = Astro.props;
const translations = translationsOf(await getPages(), page.route);
---

<BaseLayout
  language={page.language}
  route={page.route}
  title={page.title}
  description={page.description}
  keywords={page.keywords}
  translations={translations}
  layout='deployment'
  header={false}
  footer={false}
>
  <Deployment
    language={page.language}
    languageLinks={translations.map((language) => ({
      language,
      href: localizePath(language, page.route),
    }))}
  />
</BaseLayout>
