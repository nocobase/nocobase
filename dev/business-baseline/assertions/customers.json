          "expect": {
            "visible": []
          }
        }
      ]
    },
    {
      "id": "CUSTOMERS-008",
      "label": "Other owner cannot update parent or child",
      "category": "permission",
      "channel": "api",
      "steps": [
        {
          "action": "update",
          "input": {
            "actor": "otherOwner",
            "target": "draft",
            "record": {
              "name": "Alpha Customer",
              "reference": "allowed",
              "active": true,
              "contacts": [
                {
                  "name": "Ada",
                  "email": "ada@baseline.invalid"
                },
                {
                  "name": "Lin",
                  "email": "lin@baseline.invalid"
                }
              ]
            }
          },
          "expect": {
            "accepted": false
          }
        },
        {
          "action": "snapshot",
          "input": {
            "target": "draft"
          },
          "expect": {
            "unchanged": true
          }
        }
      ]
    },
    {
