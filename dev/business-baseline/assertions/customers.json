    {
      "id": "CUSTOMERS-012",
      "label": "Cannot steal a foreign child",
      "category": "permission",
      "channel": "api",
      "steps": [
        {
          "action": "update",
          "input": {
            "actor": "owner",
            "target": "draft",
            "record": {
              "name": "Alpha Customer",
              "reference": "allowed",
              "active": true,
              "contacts": [
                {
                  "name": "Ada",
                  "email": "ada@baseline.invalid"
                },
                {
                  "name": "Lin",
                  "email": "lin@baseline.invalid"
                }
              ],
              "childId": "foreignChild"
            }
          },
          "expect": {
            "accepted": false
          }
        },
        {
          "action": "snapshot",
          "input": {
            "target": "foreignDocument"
          },
          "expect": {
            "unchanged": true
          }
        }
      ]
    },
    {
      "id": "CUSTOMERS-013",
      "label": "Cannot forge ownership or protected workflow/assignment fields",
      "category": "permission",
      "channel": "api",
      "steps": [
        {
          "action": "update",
          "input": {
            "actor": "owner",
            "target": "draft",
            "record": {
              "owner": "otherOwner",
              "state": "completed",
              "reviewer": "otherReviewer",
              "assignee": "owner"
            }
          },
          "expect": {
            "forbiddenEffect": false
          }
        },
        {
          "action": "snapshot",
          "input": {
            "target": "draft"
          },
          "expect": {
            "unchanged": true
          }
        }
      ]
    },
    {
      "id": "CUSTOMERS-014",
      "label": "Failure after first child write rolls back new parent and children",
      "category": "consistency",
      "channel": "database",
      "steps": [
        {
          "action": "snapshot",
          "input": {},
          "expect": {
            "fixtureIntact": true
          }
        },
        {
          "action": "failChildWrite",
          "input": {
            "actor": "owner",
            "mode": "create",
            "record": {
              "name": "Alpha Customer",
              "reference": "allowed",
              "active": true,
              "contacts": [
                {
                  "name": "Ada",
                  "email": "ada@baseline.invalid"
                },
                {
                  "name": "Lin",
                  "email": "lin@baseline.invalid"
                }
              ]
            }
          },
          "expect": {
            "accepted": false,
            "firstChildWritten": true
          }
        },
        {
          "action": "snapshot",
          "input": {},
          "expect": {
            "unchanged": true
          }
        }
      ]
    },
    {
      "id": "CUSTOMERS-015",
      "label": "Failure after first child write preserves all existing values",
      "category": "consistency",
      "channel": "database",
      "steps": [
        {
          "action": "snapshot",
          "input": {
            "target": "draft"
          },
          "expect": {
            "fixtureIntact": true
          }
        },
        {
          "action": "failChildWrite",
          "input": {
            "actor": "owner",
            "mode": "update",
            "target": "draft",
            "record": {
              "name": "Alpha Customer",
              "reference": "allowed",
              "active": true,
              "contacts": [
                {
                  "name": "Ada",
                  "email": "ada@baseline.invalid"
                },
                {
                  "name": "Lin",
                  "email": "lin@baseline.invalid"
                }
              ]
            }
          },
          "expect": {
            "accepted": false,
            "firstChildWritten": true
          }
        },
        {
          "action": "snapshot",
          "input": {
            "target": "draft"
          },
          "expect": {
            "unchanged": true
          }
        }
      ]
    },
