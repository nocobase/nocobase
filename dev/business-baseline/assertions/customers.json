    {
      "id": "CUSTOMERS-019",
      "label": "Form resubmission creates one parent and one child set",
      "category": "consistency",
      "channel": "api",
      "steps": [
        {
          "action": "concurrent",
          "input": {
            "actor": "owner",
            "operation": "create",
            "sameOperationKey": true,
            "record": {
              "name": "Alpha Customer",
              "reference": "allowed",
              "active": true,
              "contacts": [
                {
                  "name": "Ada",
                  "email": "ada@baseline.invalid"
                },
                {
                  "name": "Lin",
                  "email": "lin@baseline.invalid"
                }
              ]
            }
          },
          "expect": {
            "createdParents": 1,
            "createdChildren": 2
          }
        }
      ]
