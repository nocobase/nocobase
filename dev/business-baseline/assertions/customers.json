{
  "version": 1,
  "scenario": "customers",
  "cases": [
    {
      "id": "CUSTOMERS-001",
      "label": "Save parent and children, then reread persisted data",
      "category": "business",
      "channel": "api",
      "steps": [
        {
          "action": "create",
          "input": {
            "actor": "owner",
            "record": {
              "name": "Alpha Customer",
              "reference": "allowed",
              "active": true,
              "contacts": [
                {
                  "name": "Ada",
                  "email": "ada@baseline.invalid"
                },
                {
                  "name": "Lin",
                  "email": "lin@baseline.invalid"
                }
              ]
            }
          },
          "expect": {
            "accepted": true,
            "childCount": 2
          }
        }
      ]
    },
    {
      "id": "CUSTOMERS-002",
      "label": "Search and filter actual page list and reference picker",
      "category": "business",
      "channel": "browser",
      "steps": [
        {
          "action": "ui",
          "input": {
            "actor": "owner",
            "flow": "search-filter",
            "query": "Alpha",
            "active": true
          },
          "expect": {
            "listFiltered": true,
            "candidates": ["allowed"]
          }
        }
      ]
    },
    {
      "id": "CUSTOMERS-003",
      "label": "Add, edit and remove children through page, persist and reopen",
      "category": "business",
      "channel": "browser",
      "steps": [
        {
          "action": "ui",
          "input": {
            "actor": "owner",
            "flow": "edit-children",
            "record": {
              "name": "Alpha Customer",
              "reference": "allowed",
              "active": true,
              "contacts": [
                {
                  "name": "Ada",
                  "email": "ada@baseline.invalid"
                },
                {
                  "name": "Lin",
                  "email": "lin@baseline.invalid"
                }
              ]
            }
          },
          "expect": {
            "reopened": true,
            "childCount": 2,
            "editedChildVisible": true
          }
        }
      ]
    },
    {
