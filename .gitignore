node_modules/
/.pnpm-store/
dist/
dist.build/
# `nocobase dist retarget` and `nocobase dist check` are found by their directory, which the rule above would
# otherwise hide. packages/app/app-cli/tests/command-files.test.ts fails if this exception is lost.
!packages/app/app-cli/src/commands/dist/
coverage/
test-results/
playwright-report/
.DS_Store
.env.local
.env.*.local
/hub-config.yml
/playground/.env
.agent-annotations/

# Generated by scripts/sync-skills.mjs: symbolic links to the Skills committed under skills/.
/.agents/skills/
/.claude/skills/

!packages/app/app-host/fixtures/app-dist/**/dist/
!packages/app/app-host/fixtures/app-dist/**/dist/**
!packages/app/app-host/fixtures/app-dist/**/dist/node_modules/
!packages/app/app-host/fixtures/app-dist/**/dist/node_modules/**

packages/app/app-host/fixtures/app-dist/main/
packages/app/app-host/fixtures/app-dist/hub/dist/
packages/app/app-host/fixtures/app-dist/hub/dist/**
# Runtime state app-host writes under its working directory when a test gives
# it no explicit location. Tests use temporary directories; this is a backstop.
packages/app/app-host/storage/

packages/templates/app-template-default/server/workflows
