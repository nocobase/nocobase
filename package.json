{
  "name": "nocobase-v3",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "prettier": "@nocobase/dev-config/prettier",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev-config:build": "pnpm --filter @nocobase/dev-config build",
    "prelint": "pnpm dev-config:build",
    "build": "NOCOBASE_SKIP_WORKSPACE_DEPENDENCY_BUILD=1 pnpm -r --if-present build",
    "changeset": "changeset",
    "lint": "pnpm -r --if-present lint && pnpm db:lint",
    "prelint:fix": "pnpm dev-config:build",
    "lint:fix": "pnpm -r --if-present lint:fix && pnpm db:lint --fix",
    "preformat": "pnpm dev-config:build",
    "format": "node ./scripts/format-changed.mjs --write",
    "preformat:all": "pnpm dev-config:build",
    "format:all": "prettier . --write --ignore-path .prettierignore",
    "preformat:check": "pnpm dev-config:build",
    "format:check": "node ./scripts/format-changed.mjs --check",
    "i18n:check": "node ./scripts/i18n-check.mjs",
    "plugin:create": "node ./packages/tools/create-plugin/bin/run.js",
    "plugin:remove": "node ./scripts/remove-plugin.mjs",
    "registry": "node ./scripts/registry.mjs",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build && pnpm pack:check && pnpm peers:check && pnpm deps:check && pnpm db-tests:check && pnpm ui-library-catalog:check && pnpm openapi:check",
    "fix": "pnpm lint:fix && pnpm format",
    "typecheck": "pnpm -r --if-present typecheck && pnpm db:typecheck",
    "pretest": "pnpm dev-config:build",
    "test": "pnpm scripts:test && pnpm -r --if-present test && pnpm db:test",
    "scripts:test": "node --import tsx --test tests/scripts/*.test.mjs",
    "test:db": "node --import tsx ./scripts/test-db.mjs",
    "pack:check": "node ./scripts/pack-check.mjs",
    "peers:check": "node ./scripts/check-peer-deps.mjs",
    "deps:check": "node ./scripts/check-runtime-deps.mjs",
    "db-tests:check": "node ./scripts/check-db-test-portability.mjs",
    "openapi:check": "node ./scripts/check-openapi.mjs",
    "ui-library-catalog": "node ./scripts/gen-ui-library-catalog.mjs",
    "ui-library-catalog:check": "node ./scripts/gen-ui-library-catalog.mjs --check",
    "postinstall": "node ./scripts/sync-skills.mjs",
    "prepare": "pnpm dev-config:build && husky",
    "examples:dev": "pnpm --filter @nocobase/app-template-examples dev",
    "examples:build": "pnpm --filter @nocobase/app-template-examples build",
    "examples:start": "pnpm --filter @nocobase/app-template-examples start",
    "default:dev": "pnpm --filter @nocobase/app-template-default dev",
    "default:build": "pnpm --filter @nocobase/app-template-default build",
    "default:start": "pnpm --filter @nocobase/app-template-default start",
    "hub:dev": "pnpm --filter @nocobase/app-template-hub dev",
    "hub:build": "pnpm --filter @nocobase/app-template-hub build",
    "hub:start": "pnpm --filter @nocobase/app-template-hub start",
    "app-host:dev": "APP_DIST_DIR=\"$PWD/packages/app/app-host/fixtures/app-dist\" pnpm --filter @nocobase/app-host dev",
    "app-host:build": "pnpm --filter @nocobase/app-host build",
    "docs:dev": "pnpm --filter @nocobase/docs dev",
    "docs:build": "pnpm --filter @nocobase/docs build",
    "docs:preview": "pnpm --filter @nocobase/docs preview",
    "db:example": "cd dev/db && tsx examples/command.ts",
    "db:playground": "cd dev/db && tsx playground/command.ts",
    "db:benchmark": "cd dev/db && tsx benchmarks/numeric/run.ts",
    "db:lint": "eslint dev/db --max-warnings 0",
    "db:typecheck": "tsc -p dev/db/tsconfig.json --noEmit",
    "db:test": "cd dev/db && vitest run",
    "db:check": "pnpm db:lint && pnpm db:typecheck && pnpm db:test",
    "unreleased:prepare": "node ./scripts/unreleased.mjs prepare",
    "unreleased:create": "node ./scripts/unreleased.mjs create",
    "unreleased:smoke": "node ./scripts/unreleased.mjs smoke",
    "unreleased:installer-smoke": "node ./scripts/unreleased.mjs installer-smoke",
    "unreleased:env": "node ./scripts/unreleased.mjs env",
    "unreleased:clean": "node ./scripts/unreleased.mjs clean"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@changesets/cli": "^3.0.1",
    "@hono/node-server": "catalog:",
    "@nocobase/app-cli": "workspace:*",
    "@nocobase/db": "workspace:*",
    "@nocobase/db-mssql": "workspace:*",
    "@nocobase/db-mysql": "workspace:*",
    "@nocobase/db-oracle": "workspace:*",
    "@nocobase/db-postgres": "workspace:*",
    "@nocobase/db-sqlite": "workspace:*",
    "@nocobase/dev-config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "hono": "catalog:",
    "husky": "catalog:",
    "knex": "catalog:",
    "lint-staged": "catalog:",
    "prettier": "catalog:",
    "publint": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
